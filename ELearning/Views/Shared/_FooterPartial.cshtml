@inject IConfiguration _config

<footer class="bg-gray-800 text-white py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
            <!-- Logo and description -->
            <div class="space-y-4">
                <h2 class="text-xl font-bold flex items-center">
                    <i class="fas fa-graduation-cap mr-2"></i>
                    EmbedSkill
                </h2>
                <p class="text-gray-400 text-sm">
                    Empowering educators to create and share knowledge with the world.
                </p>
                <div class="flex space-x-4">
                    <a href="#" class="text-gray-400 hover:text-white">
                        <i class="fab fa-facebook-f"></i>
                    </a>
                    <a href="#" class="text-gray-400 hover:text-white">
                        <i class="fab fa-twitter"></i>
                    </a>
                    <a href="#" class="text-gray-400 hover:text-white">
                        <i class="fab fa-linkedin-in"></i>
                    </a>
                    <a href="#" class="text-gray-400 hover:text-white">
                        <i class="fab fa-youtube"></i>
                    </a>
                </div>
            </div>

            <!-- Quick Links -->
            <div>
                <h3 class="text-sm font-semibold uppercase tracking-wider">Quick Links</h3>
                <ul class="mt-4 space-y-2">
                    <li><a asp-action="Index" asp-area="" asp-controller="Home" class="text-gray-400 hover:text-white text-sm">Home</a></li>
                    <li><a asp-action="Index" asp-area="" asp-controller="Courses" class="text-gray-400 hover:text-white text-sm">Courses</a></li>
                    <li><a asp-action="Details" asp-controller="Courses" asp-route-id="@(_config["FotaCourseId"] ?? "0")" class="text-gray-400 hover:text-white text-sm">Fota Course</a></li>
                    <li><a asp-action="About" asp-area="" asp-controller="Home" class="text-gray-400 hover:text-white text-sm">About Us</a></li>
                </ul>
            </div>

            <!-- Support -->
            <div>
                <h3 class="text-sm font-semibold uppercase tracking-wider">Support</h3>
                <ul class="mt-4 space-y-2">
                    <li><a href="#" class="text-gray-400 hover:text-white text-sm">Help Center</a></li>
                    <li><a href="#" class="text-gray-400 hover:text-white text-sm">Terms of Service</a></li>
                    <li><a href="#" class="text-gray-400 hover:text-white text-sm">Privacy Policy</a></li>
                    <li><a href="#" class="text-gray-400 hover:text-white text-sm">Contact Us</a></li>
                </ul>
            </div>

            <!-- Newsletter -->
            <div>
                <h3 class="text-sm font-semibold uppercase tracking-wider">Newsletter</h3>
                <p class="mt-4 text-gray-400 text-sm">
                    Subscribe to get updates on new courses and features.
                </p>
                <div class="mt-4 flex">
                    <input type="email" placeholder="Your email" class="px-4 py-2 w-full rounded-l-md focus:outline-none focus:ring-2 focus:ring-indigo-500 text-gray-900">
                    <button class="bg-indigo-600 hover:bg-indigo-700 px-4 py-2 rounded-r-md">
                        <i class="fas fa-paper-plane"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Copyright -->
        <div class="mt-8 pt-8 border-t border-gray-700 text-sm text-gray-400 text-center">
            <p>© 2025 EmbedSkill. All rights reserved.</p>
        </div>
    </div>
</footer>