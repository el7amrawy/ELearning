<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@100;200;300;400;500;600;700&family=Jaro:opsz@6..72&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap"
          rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Mona+Sans:ital,wght@0,200..900;1,200..900&display=swap"
          rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="/assets/css/output.css" rel="stylesheet" />
    <link href="/assets/toastify/toastify.min.css" rel="stylesheet" />
    <link rel="icon" href="/assets/favicon.svg">
    @await RenderSectionAsync("Styles",false)
    <title>@ViewBag.Title - EmbedSkill</title>
</head>
<body>
    <partial name="_NavBarPartial" />
    <div class="pt-16">
        @RenderBody()
    </div>
    <partial name="_FooterPartial" />

    <script src="/assets/js/index.js" type="module"></script>
    <script src="~/assets/toastify/toastify-js.js"></script>
    <partial name="_NotificationPartial" />
    @await RenderSectionAsync("Scripts",false)
</body>
</html>