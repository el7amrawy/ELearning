@model LearnCourse_ViewModel
@using ELearning.Extensions
@{
	ViewBag.Title = Model.Title;
}

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex gap-8 flex-col lg:flex-row">
    <!-- Video and Content Section -->
    <div class="flex-1">
        <!-- Video Player -->
        <div class="bg-gray-900 aspect-video rounded-2xl mb-8 shadow-xl overflow-hidden">
            <video class="w-full h-full object-cover"
                   controls
                   poster="@Model.Image">
                <source src="@(Model.Sections.FirstOrDefault()?.Lectures.FirstOrDefault()?.Video?.URL??string.Empty)" type="video/mp4">
                @* <source src="https://cdn.coverr.co/video/free/keyboard.webm" type="video/webm"> *@
                Your browser does not support the video tag.
            </video>
        </div>

        <!-- Resources Section -->
        @* <div class="bg-white rounded-2xl shadow-lg p-6 mb-8">
            <div class="p-4 bg-gray-50 rounded-lg cursor-pointer flex justify-between items-center" onclick="toggleCollapse(this)">
                <h4 class="text-lg font-semibold text-gray-900">Resources</h4>
                <i class="fas fa-chevron-down text-gray-500 transition-transform duration-200"></i>
            </div>
            <div class="p-4 space-y-3">
                <a href="#" class="flex items-center p-3 hover:bg-gray-50 rounded-lg">
                    <i class="fas fa-file-pdf mr-3 text-red-500"></i>
                    Lesson Slides (PDF)
                </a>
                <a href="#" class="flex items-center p-3 hover:bg-gray-50 rounded-lg">
                    <i class="fas fa-code mr-3 text-blue-500"></i>
                    Source Code (ZIP)
                </a>
                <a href="#" class="flex items-center p-3 hover:bg-gray-50 rounded-lg">
                    <i class="fas fa-link mr-3 text-green-500"></i>
                    Additional Reading
                </a>
            </div>
        </div> *@

        <!-- Course Description -->
        <div class="bg-white rounded-2xl shadow-lg p-6 mb-8">
            <h3 class="text-xl font-bold text-gray-900 mb-4">Course Description</h3>
            <p class="text-gray-600 mb-4">@Html.Raw(Model.Description)</p>
        </div>

        <!-- Instructor Details -->
        <div class="bg-white rounded-2xl shadow-lg p-6 mb-8">
            <h3 class="text-xl font-bold text-gray-900 mb-4">Meet Your Instructor</h3>
            <div class="flex items-center space-x-4">
                <img src="@(Model.Instructor.Image??"/assets/dashboard/imgs/user_Placeholder.png")"
                     alt="Instructor Avatar"
                     class="w-20 h-20 rounded-full object-cover">
                <div>
                    <h4 class="text-lg font-semibold text-gray-900">@Model.Instructor.FirstName @Model.Instructor.LastName</h4>
                    <p class="text-sm text-gray-500">Senior Web Developer</p>
                    <p class="text-gray-600 mt-2">@Model.Instructor.Bio</p>
                </div>
            </div>
        </div>

        <!-- Lesson Navigation -->
        <div class="flex justify-between mb-8">
            <button class="px-6 py-3 bg-gray-200 rounded-lg hover:bg-gray-300 text-gray-700 font-medium">
                <i class="fas fa-arrow-left mr-2"></i>Previous Lesson
            </button>
            <button class="px-6 py-3 bg-gradient-to-r from-blue-600 to-blue-700 text-white rounded-lg hover:from-blue-700 hover:to-blue-800 font-medium">
                Next Lesson<i class="fas fa-arrow-right ml-2"></i>
            </button>
        </div>
    </div>

    <!-- Course Sidebar -->
    <aside class="w-full lg:w-96">
        <div class="bg-white rounded-2xl shadow-lg p-6">
            <h3 class="text-xl font-bold text-gray-900 mb-6">Course Content</h3>
            <div class="space-y-6 max-h-full overflow-y-auto">
                @for (int i=0;i< Model.Sections.Count;i++)
                {
                    @* <div class="border border-gray-200 rounded-lg">
                        <div class="p-4 bg-gray-50 rounded-t-lg cursor-pointer flex justify-between items-center" onclick="toggleCollapse(this)">
                            <div>
                                <h4 class="text-lg font-semibold text-gray-900">Section @(i+1): @Model.Sections[i]?.Name</h4>
                            </div>
                            <i class="fas fa-chevron-down text-gray-500 transition-transform duration-200"></i>
                        </div>
                        <div class="p-4 space-y-3">
                            @foreach (var item in Model.Sections[i]?.Lectures)
                            {
                                <a href="#" class="flex items-center p-3 text-blue-600 bg-blue-50 rounded-lg">
                                    <i class="fas fa-play-circle mr-3 text-blue-600"></i>
                                    @item.Title
                                    <span class="ml-auto text-sm text-gray-500">@item.Video.Duration.FormatDuration()</span>
                                </a>                                
                            }
                        </div>
                    </div> *@
                }
            </div>
        </div>
    </aside>
</main>

@section Scripts{
    <script>
        // Simple toggle function for collapsible sections
        function toggleCollapse(header) {
            const content = header.nextElementSibling;
            const icon = header.querySelector('i');

            // Toggle content visibility
            content.classList.toggle('hidden');

            // Rotate chevron icon
            icon.classList.toggle('rotate-180');
        }

        // Initialize all collapsible sections
        document.addEventListener('DOMContentLoaded', () => {
            // Add rotate-180 class to all chevron icons by default if you want them to start collapsed
            document.querySelectorAll('[onclick="toggleCollapse(this)"] i').forEach(icon => {
                icon.classList.add('rotate-180');
            });

            // Collapse all content sections by default
            document.querySelectorAll('[onclick="toggleCollapse(this)"]').forEach(header => {
                header.nextElementSibling.classList.add('hidden');
            });
        });
    </script>
}