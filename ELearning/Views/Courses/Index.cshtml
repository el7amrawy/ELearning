@{
	ViewBag.Title = "Courses";
}

<div class="container mx-auto px-4 py-8">
    <!-- Search and Filter Bar -->
    <div class="bg-white p-4 rounded-lg shadow-md mb-6">
        <div class="flex flex-col md:flex-row gap-4">
            <!-- Search Field -->
            <div class="flex-1">
                <label for="search" class="block text-sm font-medium text-gray-700 mb-1">Search for a course</label>
                <div class="relative">
                    <input type="text" id="search" placeholder="Search for a course..."
                           class="w-full px-4 py-2 border rounded-lg focus:ring-2 outline-none  focus:ring-blue-500 focus:border-blue-500">
                    <button id="searchBtn" class="absolute right-2 top-2 text-gray-500 hover:text-blue-600">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </div>

            <!-- Filter by Category -->
            <div>
                <label for="category" class="block text-sm font-medium text-gray-700 mb-1">Category</label>
                <select id="category"
                        class="w-full px-4 py-2 border rounded-lg focus:ring-2 outline-none focus:ring-blue-500">
                    <option value="0">All Categories</option>
                    <option value="1">Programming</option>
                    <option value="2">Design</option>
                    <option value="3">Business</option>
                </select>
            </div>

            <!-- Filter by Price -->
            <div>
                <label for="maxPrice" class="block text-sm font-medium text-gray-700 mb-1">Max Price</label>
                <input type="number" id="maxPrice" placeholder="Maximum price"
                       class="w-full px-4 py-2 border rounded-lg focus:ring-2 outline-none focus:ring-blue-500">
            </div>

            <!-- Apply Button -->
            <div class="flex items-end">
                <button id="applyFilters"
                        class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">
                    Apply
                </button>
            </div>
        </div>
    </div>

    <!-- Search Results -->
    <div id="resultsContainer">
        <div class="text-center py-12">
            <i class="fas fa-spinner fa-spin text-4xl text-blue-500 mb-4"></i>
            <p class="text-gray-600">Loading data...</p>
        </div>
    </div>

    <!-- Pagination -->
    <div id="pagination" class="mt-8 flex justify-center hidden">
        <nav class="inline-flex rounded-md shadow">
            <button id="prevPage"
                    class="px-3 py-2 rounded-r-md border border-gray-300 bg-white text-gray-500 hover:bg-gray-50">
                <i class="fas fa-chevron-right"></i>
            </button>
            <div id="pageNumbers" class="flex">
                <!-- Page numbers will be added here -->
            </div>
            <button id="nextPage"
                    class="px-3 py-2 rounded-l-md border border-gray-300 bg-white text-gray-500 hover:bg-gray-50">
                <i class="fas fa-chevron-left"></i>
            </button>
        </nav>
    </div>
</div>

@section Scripts{
    <script src="~/assets/js/filterCourses.js"></script>
}