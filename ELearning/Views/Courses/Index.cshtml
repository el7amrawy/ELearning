@{
	ViewBag.Title = "Courses";
}

<!-- start courses -->
<div class="text-center pt-20 p-10 ">
    <h3 class=" text-3xl  mt-6 font-bold">Courses</h3>
</div>
<section class="pt-20 pb-20">
    <div class="container mx-auto">
        <div class="lg:hidden flex  flex-row relative gap-y-4 items-center mb-4">
            <input type="text" placeholder="search for your car"
                   class="search rounded-full bg-secondary w-full h-[50px]  border border-assent outline-none pl-[100px] pr-[70px] placeholder:text-white text-white placeholder:font-semibold ">
            <button class=" rounded-full rounded-r-none  flex items-center justify-center translate-all  h-[48px] px-[25px] bg-assent text-secondary absolute  ">
                <i class="ri-search-line text-2xl"></i>
            </button>
        </div>
        <div class="bg-white rounded-lg shadow-lg p-6 mb-8">
            <h3 class="text-2xl font-bold text-gray-800 mb-4">Filter Courses</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                <!-- Car Type Filter -->
                <div class="flex flex-col gap-2">
                    <label class="font-semibold text-gray-700">Course Type</label>
                    <select id="carTypeFilter" class="border rounded-lg p-2 outline-none focus:border-primary">
                        <option value="">All</option>
                        <option value="BMW">BMW</option>
                        <option value="Mercedes">Mercedes</option>
                        <option value="Audi">Audi</option>
                        <option value="Kia">Kia</option>
                        <option value="Hyundai">Hyundai</option>
                        <option value="Volkswagen">Volkswagen</option>
                        <option value="MG">MG</option>
                        <option value="Peugeot">Peugeot</option>
                    </select>
                </div>

                <!-- Fuel Type Filter -->
                <div class="flex flex-col gap-2">
                    <label class="font-semibold text-gray-700">Duration</label>
                    <select id="fuelFilter" class="border rounded-lg p-2 outline-none focus:border-primary">
                        <option value="">All</option>
                        <option value="Diesel">Diesel</option>
                        <option value="Petrol">Petrol</option>
                        <option value="Electric">Electric</option>
                        <option value="Hybrid">Hybrid</option>
                    </select>
                </div>

                <!-- Transmission Filter -->
                <div class="flex flex-col gap-2">
                    <label class="font-semibold text-gray-700">Language</label>
                    <select id="transmissionFilter" class="border rounded-lg p-2 outline-none focus:border-primary">
                        <option value="">All</option>
                        <option value="Automatic">Automatic</option>
                        <option value="Manual">Manual</option>
                    </select>
                </div>

                <!-- Price Range Filter -->
                <div class="flex flex-col gap-2">
                    <label class="font-semibold text-gray-700">Price Range</label>
                    <select id="priceFilter" class="border rounded-lg p-2 outline-none focus:border-primary">
                        <option value="">All</option>
                        <option value="0-1000">Under 1000</option>
                        <option value="1000-2000">1000 - 2000</option>
                        <option value="2000-3000">2000 - 3000</option>
                        <option value="3000+">Over 3000</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-20  items-center" id="courses-container">
            <div class="car shadow cursor-pointer rounded-lg course-card" data-tilt>
                <div>
                    <img src="./assets/images/courses/courses-1.jpg" alt="" class="course-image overflow-hidden rounded-lg rounded-b-none">
                </div>
                <div class="data">
                    <div class="flex items-center bg-[#eaefe6ed] gap-1">
                        <i class="ri-bard-fill text-primary "></i>
                        <p class="text-sm">All Levels</p>
                    </div>
                    <div class="mt-2 p-2">
                        <h4 class="course-title text-[#000] font-bold">Successful Negotiation: Master Your Negotiating Skills</h4>
                        <p class="text-[#00000085]">1st Category</p>
                        <div class="grid grid-cols-2 gap-2 mt-3 text-sm">
                            <div class="flex items-center gap-2">
                                <ion-icon name="alarm-outline"></ion-icon>
                                <span>15.3 hours</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <ion-icon name="videocam-outline"></ion-icon>
                                <span>4 lectures</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <ion-icon name="options-outline"></ion-icon>
                                <span>Beginner</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <ion-icon name="language-outline"></ion-icon>
                                <span>Russian</span>
                            </div>
                        </div>
                        <div class="flex items-center justify-between mt-4 mb-2">
                            <h3 class="course-price font-bold text-primary text-lg">580<span class="font-normal text-[#000] text-sm">Egp</span></h3>
                            <button class="add-to-cart-btn relative px-10 py-2 ml-4 overflow-hidden font-semibold rounded-lg bg-gray-800 text-gray-50 hover:bg-gray-800">
                                <span class="absolute top-0 right-0 px-5 py-1 text-xs tracking-wider text-center uppercase whitespace-no-wrap origin-bottom-left transform rotate-45 -translate-y-full translate-x-1/3 bg-[#0172dd]">New</span>
                                <span class="relative flex items-center gap-2">
                                    <p class="mb-1">Add to</p>
                                    <span>
                                        <ion-icon name="cart-outline" class="text-2xl font-bold"></ion-icon>
                                    </span>
                                </span>
                            </button>
                        </div>
                    </div>
                </div>

