@model CourseDetails_ViewModel
@using ELearning.Extensions
@{
    ViewBag.Title = Model.Title;
}

<div class="bg-gradient-to-r from-blue-500 to-blue-700 text-white py-20">
    <div class="container mx-auto px-6 flex flex-col md:flex-row items-center justify-between">
        <div class="text-center md:text-left md:w-1/2">
            <h1 class="text-4xl md:text-6xl font-extrabold mb-4 leading-tight animate__animated animate__fadeIn">
                @Html.DisplayFor(c=>c.Title)
            </h1>
            <p class="text-xl md:text-2xl mb-8 text-gray-100 drop-shadow-md">
                @Html.DisplayFor(c => c.SubTitle)
            </p>
            <button class="bg-white text-blue-600 font-bold py-4 px-10 rounded-full hover:bg-gray-100 transition duration-300 transform shadow-lg">
                <i class="fas fa-shopping-cart mr-2"></i> Add to Cart
            </button>
        </div>
        <div class="mt-8 md:mt-0 md:w-1/2 flex justify-center">
            <img src="@Model.Image" alt="Web Development Course Thumbnail" class="rounded-lg shadow-xl w-full max-w-lg">
        </div>
    </div>
</div>

<!-- Course Details -->
<div class="container mx-auto px-6 py-12">
    <div class="flex flex-col md:flex-row gap-8">
        <!-- Main Content -->
        <div class="md:w-2/3">
            <div class="bg-white rounded-lg shadow-md p-6 mb-8">
                <h2 class="text-2xl font-bold mb-4">Course Description</h2>
                <div class="mb-4 prose">
                    @Html.Raw(Model.Description)
                </div>
            </div>

            @* <div class="bg-white rounded-lg shadow-md p-6 mb-8">
                <h2 class="text-2xl font-bold mb-4">What You'll Learn</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="flex items-start">
                        <i class="fas fa-check text-green-500 mt-1 mr-2"></i>
                        <span>Build responsive websites with HTML5 and CSS3</span>
                    </div>
                    <div class="flex items-start">
                        <i class="fas fa-check text-green-500 mt-1 mr-2"></i>
                        <span>Create interactive UIs with modern JavaScript</span>
                    </div>
                    <div class="flex items-start">
                        <i class="fas fa-check text-green-500 mt-1 mr-2"></i>
                        <span>Develop single-page applications with React</span>
                    </div>
                    <div class="flex items-start">
                        <i class="fas fa-check text-green-500 mt-1 mr-2"></i>
                        <span>Build RESTful APIs with Node.js and Express</span>
                    </div>
                    <div class="flex items-start">
                        <i class="fas fa-check text-green-500 mt-1 mr-2"></i>
                        <span>Work with databases using MongoDB</span>
                    </div>
                    <div class="flex items-start">
                        <i class="fas fa-check text-green-500 mt-1 mr-2"></i>
                        <span>Implement authentication and authorization</span>
                    </div>
                </div>
            </div>
 *@
            <div class="bg-white rounded-lg shadow-md p-6">
                <h2 class="text-2xl font-bold mb-4">Course Content</h2>
                <div class="space-y-2">
                    @for (int i = 0; i < Model.Sections.Count; i++)
                    {
                        <!-- Section 1 -->
                        <div class="border rounded-lg overflow-hidden">
                        <div class="bg-gray-100 px-4 py-3 flex justify-between items-center cursor-pointer">
                            <h3 class="font-semibold">Section @(i+1): @Html.DisplayFor(m=>m.Sections[i].Name)</h3>
                            <i class="fas fa-chevron-down text-gray-500"></i>
                        </div>
                        <div class="hidden px-4 py-2 bg-white">
                            @foreach (var lecture in Model.Sections[i].Lectures)
                            {
                                <div class="flex justify-between py-2 border-b">
                                    <span class="text-gray-700"><i class="fas fa-play-circle text-blue-500 mr-2"></i> @Html.Display(lecture.Title)</span>
                                    <span class="text-gray-500">@Html.Display(lecture.Duration.FormatDuration())</span>
                                </div>
                            }
                        </div>
                    </div>   
                    }
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="md:w-1/3">
            <div class="bg-white rounded-lg shadow-md p-6 sticky top-4">
                <div class="mb-6">
                    <img src="@Model.Image" alt="Course Thumbnail" class="rounded-lg w-full mb-4">
                    <div class="flex justify-between items-center mb-4">
                        <span class="text-2xl font-bold text-gray-800">$@Model.Price</span>
                        <span class="text-gray-500 line-through">$199.99</span>
                    </div>
                    <p class="text-green-600 font-semibold mb-4"><i class="fas fa-bolt mr-2"></i> 50% OFF - Limited Time!</p>
                    <button class="w-full bg-blue-500 text-white font-bold py-3 rounded-lg hover:bg-blue-600 transition duration-300 mb-4">
                        <i class="fas fa-shopping-cart mr-2"></i> Add to Cart
                    </button>
                    <button class="w-full border border-blue-500 text-blue-500 font-bold py-3 rounded-lg hover:bg-blue-50 transition duration-300">
                        <i class="far fa-heart mr-2"></i> Add to Wishlist
                    </button>
                </div>

                <div class="border-t pt-4">
                    <h3 class="font-bold text-lg mb-3">This Course Includes</h3>
                    <ul class="space-y-2">
                        <li class="flex items-center">
                            <i class="fas fa-video text-blue-500 mr-2"></i>
                            <span>@Model.Duration.FormatDuration() on-demand video</span>
                        </li>
                        @* <li class="flex items-center">
                            <i class="fas fa-file-alt text-blue-500 mr-2"></i>
                            <span>15 articles and resources</span>
                        </li> *@
                        <li class="flex items-center">
                            <i class="fas fa-download text-blue-500 mr-2"></i>
                            <span>Downloadable assets</span>
                        </li>
                        <li class="flex items-center">
                            <i class="fas fa-infinity text-blue-500 mr-2"></i>
                            <span>Full lifetime access</span>
                        </li>
                        <li class="flex items-center">
                            <i class="fas fa-mobile-alt text-blue-500 mr-2"></i>
                            <span>Access on mobile and TV</span>
                        </li>
                        <li class="flex items-center">
                            <i class="fas fa-certificate text-blue-500 mr-2"></i>
                            <span>Certificate of completion</span>
                        </li>
                    </ul>
                </div>

                <div class="border-t pt-4 mt-4">
                    <h3 class="font-bold text-lg mb-3">Course Details</h3>
                    <ul class="space-y-2">
                        <li class="flex justify-between">
                            <span class="text-gray-600"><i class="fas fa-user-graduate mr-2 text-blue-500"></i> @Html.DisplayNameFor(c => c.Level)</span>
                            <span class="font-medium">@Html.DisplayFor(c => c.Level.Name)</span>
                        </li>
                        <li class="flex justify-between">
                            <span class="text-gray-600"><i class="fas fa-language mr-2 text-blue-500"></i> @Html.DisplayNameFor(c => c.Language)</span>
                            <span class="font-medium">@Html.DisplayFor(c => c.Language.Name)</span>
                        </li>
                        <li class="flex justify-between">
                            <span class="text-gray-600"><i class="fas fa-calendar-alt mr-2 text-blue-500"></i> @Html.DisplayNameFor(c => c.UpdatedAt)</span>
                            <span class="font-medium">@Html.DisplayFor(c=>c.UpdatedAt)</span>
                        </li>
                        <li class="flex justify-between">
                            <span class="text-gray-600"><i class="fas fa-calendar-alt mr-2 text-blue-500"></i> @Html.DisplayNameFor(c => c.CreatedAt)</span>
                            <span class="font-medium">@Html.DisplayFor(c => c.CreatedAt)</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Instructor Section -->
<div class="bg-gray-100 py-12">
    <div class="container mx-auto px-6">
        <h2 class="text-3xl font-bold text-center mb-8">Meet Your Instructor</h2>
        <div class="flex flex-col md:flex-row items-center bg-white rounded-lg shadow-md p-8 max-w-4xl mx-auto">
            <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?ixlib=rb-4.0.3&auto=format&fit=crop&w=150&h=150" alt="Instructor" class="rounded-full w-32 h-32 md:w-40 md:h-40 object-cover mb-6 md:mb-0 md:mr-8">
            <div>
                <h3 class="text-2xl font-bold mb-2">Alex Johnson</h3>
                <p class="text-blue-500 font-medium mb-4">Senior Web Developer & Educator</p>
                <p class="text-gray-700 mb-4">
                    Alex has over 10 years of experience in web development and has taught thousands of students worldwide.
                    He specializes in JavaScript frameworks and has worked with companies like Google, Microsoft, and Airbnb.
                </p>
                <div class="flex items-center space-x-4">
                    <div class="flex items-center">
                        <i class="fas fa-star text-yellow-400 mr-1"></i>
                        <span class="font-medium">4.9</span>
                    </div>
                    <div class="flex items-center">
                        <i class="fas fa-users text-blue-500 mr-1"></i>
                        <span class="font-medium">12,345 Students</span>
                    </div>
                    <div class="flex items-center">
                        <i class="fas fa-book text-blue-500 mr-1"></i>
                        <span class="font-medium">8 Courses</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Testimonials -->
<div class="py-12 bg-white">
    <div class="container mx-auto px-6">
        <h2 class="text-3xl font-bold text-center mb-8">What Students Say</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Testimonial 1 -->
            <div class="bg-gray-50 rounded-lg shadow-md p-6">
                <div class="flex items-center mb-4">
                    <div class="flex-shrink-0">
                        <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?ixlib=rb-4.0.3&auto=format&fit=crop&w=50&h=50" alt="Student" class="rounded-full h-12 w-12">
                    </div>
                    <div class="ml-4">
                        <h4 class="font-bold">Sarah Miller</h4>
                        <div class="flex">
                            <i class="fas fa-star text-yellow-400"></i>
                            <i class="fas fa-star text-yellow-400"></i>
                            <i class="fas fa-star text-yellow-400"></i>
                            <i class="fas fa-star text-yellow-400"></i>
                            <i class="fas fa-star text-yellow-400"></i>
                        </div>
                    </div>
                </div>
                <p class="text-gray-700">
                    "This course completely transformed my career. The projects were challenging but rewarding,
                    and I was able to land a front-end developer job after completing it."
                </p>
            </div>

            <!-- Testimonial 2 -->
            <div class="bg-gray-50 rounded-lg shadow-md p-6">
                <div class="flex items-center mb-4">
                    <div class="flex-shrink-0">
                        <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?ixlib=rb-4.0.3&auto=format&fit=crop&w=50&h=50" alt="Student" class="rounded-full h-12 w-12">
                    </div>
                    <div class="ml-4">
                        <h4 class="font-bold">David Chen</h4>
                        <div class="flex">
                            <i class="fas fa-star text-yellow-400"></i>
                            <i class="fas fa-star text-yellow-400"></i>
                            <i class="fas fa-star text-yellow-400"></i>
                            <i class="fas fa-star text-yellow-400"></i>
                            <i class="fas fa-star text-yellow-400"></i>
                        </div>
                    </div>
                </div>
                <p class="text-gray-700">
                    "Alex explains complex concepts in a way that's easy to understand. The course structure
                    is well thought out and builds your skills progressively."
                </p>
            </div>

            <!-- Testimonial 3 -->
            <div class="bg-gray-50 rounded-lg shadow-md p-6">
                <div class="flex items-center mb-4">
                    <div class="flex-shrink-0">
                        <img src="https://images.unsplash.com/photo-1488426862026-3ee34a7d66df?ixlib=rb-4.0.3&auto=format&fit=crop&w=50&h=50" alt="Student" class="rounded-full h-12 w-12">
                    </div>
                    <div class="ml-4">
                        <h4 class="font-bold">Maria Garcia</h4>
                        <div class="flex">
                            <i class="fas fa-star text-yellow-400"></i>
                            <i class="fas fa-star text-yellow-400"></i>
                            <i class="fas fa-star text-yellow-400"></i>
                            <i class="fas fa-star text-yellow-400"></i>
                            <i class="fas fa-star-half-alt text-yellow-400"></i>
                        </div>
                    </div>
                </div>
                <p class="text-gray-700">
                    "The hands-on projects were the best part. I now have several professional-quality projects
                    in my portfolio that helped me stand out to employers."
                </p>
            </div>
        </div>
    </div>
</div>

<!-- FAQ Section -->
<div class="bg-gray-100 py-12">
    <div class="container mx-auto px-6 max-w-4xl">
        <h2 class="text-3xl font-bold text-center mb-8">Frequently Asked Questions</h2>
        <div class="space-y-4">
            <!-- FAQ Item 1 -->
            <div class="faq-accordion border rounded-lg overflow-hidden">
                <button class="w-full bg-white px-4 py-3 flex justify-between items-center cursor-pointer hover:bg-blue-50 transition duration-300">
                    <h3 class="font-semibold text-gray-800">When does the course start and finish?</h3>
                    <i class="fas fa-chevron-down text-blue-500 transition-transform duration-300"></i>
                </button>
                <div class="faq-content hidden px-4 py-2 bg-white border-t transition-all duration-300">
                    <p class="text-gray-700">
                        The course is completely self-paced - you decide when you start and when you finish.
                        You get immediate access to all course materials after enrollment.
                    </p>
                </div>
            </div>

            <!-- FAQ Item 2 -->
            <div class="faq-accordion border rounded-lg overflow-hidden">
                <button class="w-full bg-white px-4 py-3 flex justify-between items-center cursor-pointer hover:bg-blue-50 transition duration-300">
                    <h3 class="font-semibold text-gray-800">How long do I have access to the course?</h3>
                    <i class="fas fa-chevron-down text-blue-500 transition-transform duration-300"></i>
                </button>
                <div class="faq-content hidden px-4 py-2 bg-white border-t transition-all duration-300">
                    <p class="text-gray-700">
                        After enrolling, you have unlimited access to this course for as long as you like -
                        across any and all devices you own.
                    </p>
                </div>
            </div>

            <!-- FAQ Item 3 -->
            <div class="faq-accordion border rounded-lg overflow-hidden">
                <button class="w-full bg-white px-4 py-3 flex justify-between items-center cursor-pointer hover:bg-blue-50 transition duration-300">
                    <h3 class="font-semibold text-gray-800">What if I'm unhappy with the course?</h3>
                    <i class="fas fa-chevron-down text-blue-500 transition-transform duration-300"></i>
                </button>
                <div class="faq-content hidden px-4 py-2 bg-white border-t transition-all duration-300">
                    <p class="text-gray-700">
                        We would never want you to be unhappy! If you're unsatisfied with your purchase,
                        contact us in the first 30 days and we'll give you a full refund.
                    </p>
                </div>
            </div>

            <!-- FAQ Item 4 -->
            <div class="faq-accordion border rounded-lg overflow-hidden">
                <button class="w-full bg-white px-4 py-3 flex justify-between items-center cursor-pointer hover:bg-blue-50 transition duration-300">
                    <h3 class="font-semibold text-gray-800">Do I need any prior experience?</h3>
                    <i class="fas fa-chevron-down text-blue-500 transition-transform duration-300"></i>
                </button>
                <div class="faq-content hidden px-4 py-2 bg-white border-t transition-all duration-300">
                    <p class="text-gray-700">
                        No prior experience is required! This course is designed to take you from beginner
                        to advanced level. We start with the fundamentals and build up to more complex topics.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Call to Action -->
<div class="bg-blue-500 text-white py-16">
    <div class="container mx-auto px-6 text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">Ready to Start Learning?</h2>
        <p class="text-xl mb-8 max-w-2xl mx-auto">Join thousands of students who have transformed their careers with this course.</p>
        <button class="bg-white text-blue-500 font-bold py-3 px-8 rounded-full hover:bg-gray-100 transition duration-300">
            <i class="fas fa-shopping-cart mr-2"></i> Add to Cart - 50% Off!
        </button>
    </div>
</div>

@section Scripts{
    <script src="/assets/js/courseDetails.js"></script>
}