@model SignIn_ViewModel
@{
	ViewBag.Title = "Sign In";
}

<!-- Sign In Section -->
<main class="bg-gradient-to-br from-blue-500 via-cyan-500 via-purple-500 to-pink-500 bg-cyan-600/15 min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8 bg-white p-8 rounded-xl shadow-2xl">
        <div>
            <h2 class="text-center text-3xl font-extrabold text-gray-900">
                Sign In to EmbedSkill
            </h2>
            <p class="mt-2 text-center text-sm text-gray-600">
                Access your courses and start learning today
            </p>
        </div>
        <form asp-action="SignIn" class="mt-8 space-y-6">
            <div class="space-y-4">
                <div>
                    <label asp-for="Email" class="sr-only"></label>
                    <input asp-for="Email" class="appearance-none rounded-md relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-blue-500 focus:border-blue-500 focus:z-10 sm:text-sm" placeholder="@Html.DisplayNameFor(a=>a.Email)">
                    <span asp-validation-for="Email" class="text-red-500 text-sm mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Password" class="sr-only"></label>
                    <input asp-for="Password" class="appearance-none rounded-md relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-blue-500 focus:border-blue-500 focus:z-10 sm:text-sm" placeholder="@Html.DisplayNameFor(a=>a.Password)">
                    <span asp-validation-for="Password" class="text-red-500 text-sm mt-1 block"></span>
                </div>
            </div>

            <div class="flex items-center justify-between">
                <div class="text-sm">
                    <a href="#" class="font-medium text-blue-500 hover:text-blue-600 transition duration-300">
                        Forgot your password?
                    </a>
                </div>
            </div>

            <div>
                <button type="submit" class="group relative w-full py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-blue-500 hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition duration-300">
                    <i class="fas fa-sign-in-alt mr-2"></i> Sign In
                </button>
            </div>
        </form>
        <p class="mt-2 text-center text-sm text-gray-600">
            Don't have an account?
            <a asp-action="Signup" class="font-medium text-blue-500 hover:text-blue-600 transition duration-300">
                Sign Up
            </a>
        </p>
    </div>
</main>

@section Scripts{
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}