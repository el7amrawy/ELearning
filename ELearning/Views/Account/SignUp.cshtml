@model SignUp_ViewModel
@{
	ViewBag.Title = "Sign Up";
}

<!-- Sign Up Section -->
<div class="bg-gradient-to-r from-blue-500 to-blue-700 min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8 bg-white p-8 rounded-xl shadow-2xl">
        <div>
            <h2 class="text-center text-3xl font-extrabold text-gray-900">
                Sign up and start learning
            </h2>
            <p class="mt-2 text-center text-sm text-gray-600">
                Create your account to access our courses
            </p>
        </div>
        <form class="mt-8 space-y-6" asp-action="SignUp">
            <div class="space-y-4">
                <div class="input-control">
                    <label asp-for="FirstName" class="sr-only"></label>
                    <input asp-for="FirstName" class="appearance-none rounded-md relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-blue-500 focus:border-blue-500 focus:z-10 sm:text-sm" placeholder="@Html.DisplayNameFor(a=>a.FirstName)">
                    <span asp-validation-for="FirstName" class="text-red-500 text-sm mt-1 block"></span>
                </div>
                <div class="input-control">
                    <label asp-for="LastName" class="sr-only"></label>
                    <input asp-for="LastName" id="lastName" class="appearance-none rounded-md relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-blue-500 focus:border-blue-500 focus:z-10 sm:text-sm" placeholder="@Html.DisplayNameFor(a=>a.LastName)">
                    <span asp-validation-for="LastName" class="text-red-500 text-sm mt-1 block"></span>
                </div>
                <div class="input-control">
                    <label asp-for="Username" class="sr-only"></label>
                    <input asp-for="Username" class="appearance-none rounded-md relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-blue-500 focus:border-blue-500 focus:z-10 sm:text-sm" placeholder="@Html.DisplayNameFor(a=>a.Username)">
                    <span asp-validation-for="Username"class="text-red-500 text-sm mt-1 block"></span>
                </div>
                <div class="input-control">
                    <label asp-for="Email" class="sr-only"></label>
                    <input asp-for="Email" class="appearance-none rounded-md relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-blue-500 focus:border-blue-500 focus:z-10 sm:text-sm" placeholder="@Html.DisplayNameFor(a=>a.Email)">
                    <span asp-validation-for="Email" class="text-red-500 text-sm mt-1 block"></span>
                </div>
                <div class="input-control">
                    <label asp-for="Password" class="sr-only"></label>
                    <input asp-for="Password" class="appearance-none rounded-md relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-blue-500 focus:border-blue-500 focus:z-10 sm:text-sm" placeholder="@Html.DisplayNameFor(a=>a.Password)">
                    <span asp-validation-for="Password" class="text-red-500 text-sm mt-1 block max-w-full"></span>
                </div>
            </div>

            <div>
                <button type="submit" class="group relative w-full py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-blue-500 hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition duration-300">
                    <i class="fas fa-user-plus mr-2"></i> Sign Up
                </button>
            </div>
            <p class="mt-2 text-center text-sm text-gray-600">
                Already have an account?
                <a asp-action="SignIn" class="font-medium text-blue-500 hover:text-blue-600 transition duration-300" asp-action="SignIn" asp-controller="Account">Sign In</a>
            </p>
        </form>
    </div>
</div>


@section Scripts{
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}