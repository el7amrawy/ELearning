@model HomeIndex_ViewModel
@inject IConfiguration _config
@{
    ViewBag.Title = "Home";
}

<main class="bg-gray-50 font-sans">
    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-blue-500 to-blue-700 text-white py-32">
        <div class="container mx-auto px-6 text-center">
            <h1 class="text-4xl md:text-6xl font-bold mb-6">Learn Without Limits</h1>
            <p class="text-xl md:text-2xl mb-8 max-w-3xl mx-auto">Start, switch, or advance your career with 5,000+ courses, Professional Certificates, and degrees from world-class universities and companies.</p>
            <form method="get" asp-action="Index" asp-controller="Courses" class="flex flex-col sm:flex-row justify-center gap-4">
                <input name="search" type="text" placeholder="What do you want to learn?" class="px-6 py-3 rounded-md text-gray-800 w-full sm:w-96 focus:outline-none focus:ring-2 focus:ring-blue-300">
                <button type="submit" class="px-8 py-3 bg-white text-blue-500 font-semibold rounded-md hover:bg-gray-100 transition duration-300">Search Courses</button>
            </form>
        </div>
    </section>

    <!-- Stats Section -->
    <section class="py-12 bg-white">
        <div class="container mx-auto px-6">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8 text-center">
                <div class="p-6">
                    <h3 class="text-4xl font-bold text-blue-500">10,000+</h3>
                    <p class="text-gray-600 mt-2">Active Students</p>
                </div>
                <div class="p-6">
                    <h3 class="text-4xl font-bold text-blue-500">500+</h3>
                    <p class="text-gray-600 mt-2">Expert Instructors</p>
                </div>
                <div class="p-6">
                    <h3 class="text-4xl font-bold text-blue-500">5,000+</h3>
                    <p class="text-gray-600 mt-2">Online Courses</p>
                </div>
                <div class="p-6">
                    <h3 class="text-4xl font-bold text-blue-500">24/7</h3>
                    <p class="text-gray-600 mt-2">Learning Support</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Popular Courses -->
    <section class="py-16 bg-gray-50">
        <div class="container mx-auto px-6">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold text-gray-800 mb-4">Popular Courses</h2>
                <p class="text-gray-600 max-w-2xl mx-auto">Browse our most popular courses that students are taking right now</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                @foreach (var course in Model.Courses)
                {
                    <partial name="_CourseCardPartialView" model="course" />
                }
                <!-- Course Card with Instructor -->
                </div>
            <div class="text-center mt-10">
                <a href="#" class="px-8 py-3 bg-blue-500 text-white rounded-md hover:bg-blue-600 transition duration-300 inline-block">View All Courses</a>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="py-16 bg-white">
        <div class="container mx-auto px-6">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold text-gray-800 mb-4">Why Choose LearnHub?</h2>
                <p class="text-gray-600 max-w-2xl mx-auto">We provide the best learning experience with our unique features</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="text-center p-6 hover:bg-gray-50 rounded-lg transition duration-300">
                    <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-laptop-code text-blue-500 text-2xl"></i>
                    </div>
                    <h3 class="text-xl font-semibold text-gray-800 mb-2">Learn Anything</h3>
                    <p class="text-gray-600">Choose from 5,000+ courses across 200+ subjects from top instructors.</p>
                </div>

                <div class="text-center p-6 hover:bg-gray-50 rounded-lg transition duration-300">
                    <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-user-graduate text-blue-500 text-2xl"></i>
                    </div>
                    <h3 class="text-xl font-semibold text-gray-800 mb-2">Learn Together</h3>
                    <p class="text-gray-600">Join a community of 10,000+ learners and get support from peers.</p>
                </div>

                <div class="text-center p-6 hover:bg-gray-50 rounded-lg transition duration-300">
                    <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-certificate text-blue-500 text-2xl"></i>
                    </div>
                    <h3 class="text-xl font-semibold text-gray-800 mb-2">Earn Certificates</h3>
                    <p class="text-gray-600">Get recognized for your work with shareable certificates upon completion.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Testimonials -->
    <section class="py-16 bg-gray-50">
        <div class="container mx-auto px-6">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold text-gray-800 mb-4">What Our Students Say</h2>
                <p class="text-gray-600 max-w-2xl mx-auto">Hear from our community of learners who have transformed their careers</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="bg-white p-6 rounded-lg shadow-md">
                    <div class="flex items-center mb-4">
                        <img src="https://randomuser.me/api/portraits/women/32.jpg" alt="Sarah Johnson" class="w-12 h-12 rounded-full object-cover">
                        <div class="ml-4">
                            <h4 class="font-semibold text-gray-800">Sarah Johnson</h4>
                            <p class="text-gray-600 text-sm">Web Developer</p>
                        </div>
                    </div>
                    <p class="text-gray-600">"The web development course helped me land my first job as a front-end developer. The curriculum was comprehensive and the projects were practical."</p>
                    <div class="mt-4 text-yellow-500">
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                    </div>
                </div>

                <div class="bg-white p-6 rounded-lg shadow-md">
                    <div class="flex items-center mb-4">
                        <img src="https://randomuser.me/api/portraits/men/45.jpg" alt="Michael Chen" class="w-12 h-12 rounded-full object-cover">
                        <div class="ml-4">
                            <h4 class="font-semibold text-gray-800">Michael Chen</h4>
                            <p class="text-gray-600 text-sm">Data Scientist</p>
                        </div>
                    </div>
                    <p class="text-gray-600">"The data science program gave me the skills I needed to transition from finance to tech. The instructors were knowledgeable and supportive."</p>
                    <div class="mt-4 text-yellow-500">
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star-half-alt"></i>
                    </div>
                </div>

                <div class="bg-white p-6 rounded-lg shadow-md">
                    <div class="flex items-center mb-4">
                        <img src="https://randomuser.me/api/portraits/women/68.jpg" alt="Emma Rodriguez" class="w-12 h-12 rounded-full object-cover">
                        <div class="ml-4">
                            <h4 class="font-semibold text-gray-800">Emma Rodriguez</h4>
                            <p class="text-gray-600 text-sm">Marketing Specialist</p>
                        </div>
                    </div>
                    <p class="text-gray-600">"The digital marketing course provided actionable strategies that I implemented immediately at work. My campaigns have seen a 40% improvement in ROI."</p>
                    <div class="mt-4 text-yellow-500">
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 bg-blue-500 text-white">
        <div class="container mx-auto px-6 text-center">
            <h2 class="text-3xl font-bold mb-6">Ready to Transform Your Career?</h2>
            <p class="text-xl mb-8 max-w-2xl mx-auto">Join thousands of learners who have achieved their goals with LearnHub.</p>
            <div class="flex flex-col sm:flex-row justify-center gap-4">
                <a href="#" class="px-8 py-3 bg-white text-blue-500 font-semibold rounded-md hover:bg-gray-100 transition duration-300">Start Learning Now</a>
                <a href="#" class="px-8 py-3 border-2 border-white text-white font-semibold rounded-md hover:bg-white hover:text-blue-500 transition duration-300">Talk to an Advisor</a>
            </div>
        </div>
    </section>

</main>

@section Exclusive{
    <partial name="ExclusivePartial" model="@(_config["Exclusive"]??"#")"/>
}