@{
    ViewBag.Title = "Become an instructor";
}

<section class="bg-gradient-to-r from-blue-50 via-blue-100 to-blue-50 bg-[length:600%_600%] animate-[gradient_15s_ease_infinite] flex items-center justify-center min-h-screen">
    <form asp-action="BecomeInstructor" class="text-center p-6 max-w-md w-full bg-white bg-opacity-90 rounded-lg shadow-lg">
        <h1 class="text-3xl font-bold text-blue-500 mb-4">Join Our Team</h1>
        <p class="text-gray-600 mb-6">Share your expertise and inspire others by becoming an instructor today!</p>
        <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 px-4 rounded-lg transition duration-300 ease-in-out flex items-center justify-center mx-auto">
            <i class="fas fa-chalkboard-teacher mr-2"></i> Become an Instructor
        </button>
    </form>
</section>
