@model IEnumerable<Enrollment_ViewModel>
@{
	ViewBag.Title = "My Enrolled Courses";
}

<!-- Main Content -->
<main class="container mx-auto px-4 py-6 sm:py-8">
    <!-- Courses Section -->
    <div class="bg-white rounded-lg shadow overflow-hidden">
        <!-- Page Header -->
        <div class="bg-blue-500 text-white px-4 sm:px-6 py-4">
            <h2 class="text-lg sm:text-xl font-semibold flex items-center">
                <i class="fas fa-book-open mr-2"></i>My Enrolled Courses
            </h2>
        </div>

        <!-- Courses Grid -->
        <div class="p-4 sm:p-6">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
                @foreach (var enrollment in Model)
                {
                    <partial name="_CourseCardPartialView" model="enrollment.Course" />
                }

                <!-- Add New Course Card -->
                <div class="border-2 border-dashed border-gray-300 rounded-lg hover:border-blue-500 transition-colors duration-300">
                    <div class="h-full flex flex-col items-center justify-center p-6 sm:p-8 text-center">
                        <div class="bg-blue-100 w-12 sm:w-16 h-12 sm:h-16 rounded-full flex items-center justify-center mb-4">
                            <i class="fas fa-plus text-blue-500 text-xl sm:text-2xl"></i>
                        </div>
                        <h3 class="text-base sm:text-lg font-medium text-gray-700 mb-2">Explore New Courses</h3>
                        <button class="bg-blue-500 hover:bg-blue-600 text-white py-2 px-4 rounded-md text-sm font-medium transition-colors duration-300">
                            Browse Courses
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
