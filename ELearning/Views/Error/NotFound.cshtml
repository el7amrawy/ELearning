@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Page Not Found</title>
    <link href="/assets/css/output.css" rel="stylesheet" />
</head>
<body class="bg-gray-100">
    <div class="min-h-screen flex items-center justify-center px-4">
        <div class="max-w-md w-full text-center">
            <div class="text-purple-500 text-6xl mb-4">
                🔍
            </div>
            <h1 class="text-4xl font-bold text-gray-800 mb-4">
                404 - Page Not Found
            </h1>
            <p class="text-gray-600 mb-8">
                The page you're looking for doesn't exist or has been moved.
                Please check the URL or return to our homepage.
            </p>
            <a asp-action="index" asp-controller="Home" class="inline-block px-6 py-3 bg-purple-500 text-white rounded-lg hover:bg-purple-600 transition duration-200">
                Go Home
            </a>
        </div>
    </div>
</body>
</html>