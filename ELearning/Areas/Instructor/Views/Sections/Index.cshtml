@model CreateSection_ViewModel
@inject IUnitOfWork _uof
@{
    ViewBag.Title = "Mangae Sections";
    ViewBag.ActiveTab = NavTabsEnum.Courses;

    var courseId = int.Parse(Context.Request.RouteValues["CourseId"].ToString());

    var course = await _uof.Courses.GetItemAsync<SectionCourse_ViewModel>(c => c.Id == courseId);
}

<div class="mx-auto px-4 py-8 max-w-4xl">
    <!-- Course Info Banner -->
    <div class="bg-indigo-50 border-l-4 border-indigo-500 p-4 mb-6 rounded-lg">
        <div class="flex items-center">
            <i class="fas fa-info-circle text-indigo-500 text-xl mr-3"></i>
            <div>
                <h3 class="font-semibold">@course.Title</h3>
                <p class="text-sm text-gray-600">Add modules/sections to organize your course</p>
            </div>
        </div>
    </div>

    <div class="mb-8 relative">
        <div class="text-center">
            <h1 class="text-3xl font-bold text-gray-800 inline-block">
                <i class="fas fa-layer-group text-indigo-500 mr-2"></i> Sections
            </h1>
        </div>
        <!-- Back Button -->
        <a asp-action="manage" class="absolute left-0 top-1 bg-gray-100 hover:bg-gray-200 text-gray-600 px-4 py-2 rounded-lg transition">
            <i class="fas fa-arrow-left mr-2"></i> Go Back
        </a>
    </div>

    <!-- Existing Sections (Dynamic) -->
    <div class="bg-white p-6 rounded-xl shadow-md mb-6 border border-gray-200">
        <h3 class="font-medium text-lg mb-4 flex items-center">
            <i class="fas fa-list-ol text-indigo-500 mr-2"></i> Current Sections
        </h3>
        <!-- Section List -->
        <div class="divide-y divide-gray-100">
            <!-- Section 1 -->
            <div class="p-4 hover:bg-gray-50 group">
                <div class="flex justify-between items-start">
                    <div>
                        <h3 class="font-medium text-gray-800 mb-1">1. JavaScript Fundamentals</h3>
                        <div class="flex items-center text-xs text-gray-500 space-x-3">
                            <span><i class="fas fa-clock mr-0.5"></i> 45 min</span>
                            <span><i class="fas fa-play-circle mr-0.5"></i> 3 lessons</span>
                        </div>
                    </div>
                    <div class="flex space-x-1 items-center">
                        <a href="edit-section.html" class="p-1.5 text-blue-600 hover:text-blue-800 text-sm" title="Edit">
                            <i class="fas fa-cog mr-2"></i>
                        </a>
                        <div class="flex flex-col space-y-1">
                            <button class="p-1 text-gray-500 hover:text-gray-700 text-xs" title="Move up">
                                <i class="fas fa-arrow-up"></i>
                            </button>
                            <button class="p-1 text-gray-500 hover:text-gray-700 text-xs" title="Move down">
                                <i class="fas fa-arrow-down"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 2 -->
            <div class="p-4 hover:bg-gray-50 group">
                <div class="flex justify-between items-start">
                    <div>
                        <h3 class="font-medium text-gray-800 mb-1">2. JavaScript Fundamentals</h3>
                        <div class="flex items-center text-xs text-gray-500 space-x-3">
                            <span><i class="fas fa-clock mr-0.5"></i> 45 min</span>
                            <span><i class="fas fa-play-circle mr-0.5"></i> 3 lessons</span>
                        </div>
                    </div>
                    <div class="flex space-x-1 items-center">
                        <a href="edit-section.html" class="p-1.5 text-blue-600 hover:text-blue-800 text-sm" title="Edit">
                            <i class="fas fa-cog mr-2"></i>
                        </a>
                        <div class="flex flex-col space-y-1">
                            <button class="p-1 text-gray-500 hover:text-gray-700 text-xs" title="Move up">
                                <i class="fas fa-arrow-up"></i>
                            </button>
                            <button class="p-1 text-gray-500 hover:text-gray-700 text-xs" title="Move down">
                                <i class="fas fa-arrow-down"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Section 3 -->
            <div class="p-4 hover:bg-gray-50 group">
                <div class="flex justify-between items-start">
                    <div>
                        <h3 class="font-medium text-gray-800 mb-1">3. JavaScript Fundamentals</h3>
                        <div class="flex items-center text-xs text-gray-500 space-x-3">
                            <span><i class="fas fa-clock mr-0.5"></i> 45 min</span>
                            <span><i class="fas fa-play-circle mr-0.5"></i> 3 lessons</span>
                        </div>
                    </div>
                    <div class="flex space-x-1 items-center">
                        <a href="edit-section.html" class="p-1.5 text-blue-600 hover:text-blue-800 text-sm" title="Edit">
                            <i class="fas fa-cog mr-2"></i>
                        </a>
                        <div class="flex flex-col space-y-1">
                            <button class="p-1 text-gray-500 hover:text-gray-700 text-xs" title="Move up">
                                <i class="fas fa-arrow-up"></i>
                            </button>
                            <button class="p-1 text-gray-500 hover:text-gray-700 text-xs" title="Move down">
                                <i class="fas fa-arrow-down"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Add New Section Form -->
    <div class="bg-white p-6 rounded-xl shadow-md border border-gray-200">
        <h3 class="font-medium text-lg mb-4 flex items-center">
            <i class="fas fa-plus-circle text-indigo-500 mr-2"></i> New Section
        </h3>
        <form asp-action="Index">
            <input asp-for="CourseId" value="@courseId" hidden />
            <div class="mb-4">
                <label class="block text-gray-700 font-medium mb-2">
                    Section Title
                </label>
                <input asp-for="Name" placeholder="E.g., Loops and Functions"
                       class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                <span asp-validation-for="Name" class="text-red-500"></span>
            </div>
            <button type="submit" class="bg-green-500 hover:bg-green-600 text-white py-2 px-4 rounded-lg">
                <i class="fas fa-save mr-2"></i> Add Section
            </button>
        </form>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}