@{
    ViewBag.Title = "Home";
    ViewBag.ActiveTab = NavTabsEnum.Dashboard;
}

<!-- Main Content -->
<div class="py-10">
    <div class="max-w-7xl mx-auto sm:px-6 lg:px-8">
        <!-- Welcome Banner -->
        <div class="bg-indigo-700 rounded-lg shadow px-5 py-6 sm:px-6 mb-8">
            <div class="flex flex-wrap items-center justify-between">
                <div class="flex-1 min-w-0">
                    <h2 class="text-2xl font-bold leading-7 text-white sm:text-3xl sm:truncate">Welcome back, Professor Smith!</h2>
                    <p class="mt-1 text-indigo-200">You have 3 courses with 245 active students this month.</p>
                </div>
                <div class="mt-4 flex-shrink-0 sm:mt-0 sm:ml-4">
                    <button type="button" class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-indigo-600 bg-white hover:bg-indigo-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                        Create New Course
                    </button>
                </div>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4 mb-8">
            <div class="bg-white overflow-hidden shadow rounded-lg">
                <div class="px-4 py-5 sm:p-6">
                    <div class="flex items-center">
                        <div class="flex-shrink-0 bg-indigo-500 rounded-md p-3">
                            <i class="fas fa-graduation-cap text-white"></i>
                        </div>
                        <div class="ml-5 w-0 flex-1">
                            <dt class="text-sm font-medium text-gray-500 truncate">
                                Total Students
                            </dt>
                            <dd class="flex items-baseline">
                                <div class="text-2xl font-semibold text-gray-900">
                                    1,245
                                </div>
                            </dd>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-white overflow-hidden shadow rounded-lg">
                <div class="px-4 py-5 sm:p-6">
                    <div class="flex items-center">
                        <div class="flex-shrink-0 bg-green-500 rounded-md p-3">
                            <i class="fas fa-book-open text-white"></i>
                        </div>
                        <div class="ml-5 w-0 flex-1">
                            <dt class="text-sm font-medium text-gray-500 truncate">
                                Active Courses
                            </dt>
                            <dd class="flex items-baseline">
                                <div class="text-2xl font-semibold text-gray-900">
                                    8
                                </div>
                            </dd>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-white overflow-hidden shadow rounded-lg">
                <div class="px-4 py-5 sm:p-6">
                    <div class="flex items-center">
                        <div class="flex-shrink-0 bg-yellow-500 rounded-md p-3">
                            <i class="fas fa-comments text-white"></i>
                        </div>
                        <div class="ml-5 w-0 flex-1">
                            <dt class="text-sm font-medium text-gray-500 truncate">
                                New Messages
                            </dt>
                            <dd class="flex items-baseline">
                                <div class="text-2xl font-semibold text-gray-900">
                                    12
                                </div>
                            </dd>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-white overflow-hidden shadow rounded-lg">
                <div class="px-4 py-5 sm:p-6">
                    <div class="flex items-center">
                        <div class="flex-shrink-0 bg-red-500 rounded-md p-3">
                            <i class="fas fa-star text-white"></i>
                        </div>
                        <div class="ml-5 w-0 flex-1">
                            <dt class="text-sm font-medium text-gray-500 truncate">
                                Average Rating
                            </dt>
                            <dd class="flex items-baseline">
                                <div class="text-2xl font-semibold text-gray-900">
                                    4.8
                                </div>
                            </dd>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Courses Section -->
        <div class="mb-8">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-lg leading-6 font-medium text-gray-900">Your Courses</h2>
                <a href="#" class="text-sm text-indigo-600 hover:text-indigo-500">View all courses</a>
            </div>

            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                <!-- Course Card 1 -->
                <div class="bg-white overflow-hidden shadow rounded-lg">
                    <div class="h-40 bg-indigo-600 flex items-center justify-center">
                        <span class="text-white text-xl font-bold">Advanced JavaScript</span>
                    </div>
                    <div class="px-4 py-5 sm:p-6">
                        <div class="flex items-center justify-between mb-3">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                Active
                            </span>
                            <div class="text-sm text-gray-500">245 students</div>
                        </div>
                        <h3 class="text-lg font-medium text-gray-900 mb-2">Advanced JavaScript Concepts</h3>
                        <p class="text-sm text-gray-500 mb-4">Master advanced JavaScript patterns, frameworks, and performance optimization.</p>
                        <div class="flex justify-between items-center">
                            <div class="flex items-center">
                                <i class="fas fa-star text-yellow-400 mr-1"></i>
                                <span class="text-sm font-medium text-gray-700">4.9</span>
                            </div>
                            <a href="#" class="text-indigo-600 hover:text-indigo-500 text-sm font-medium">Manage Course</a>
                        </div>
                    </div>
                </div>

                <!-- Course Card 2 -->
                <div class="bg-white overflow-hidden shadow rounded-lg">
                    <div class="h-40 bg-purple-600 flex items-center justify-center">
                        <span class="text-white text-xl font-bold">React Mastery</span>
                    </div>
                    <div class="px-4 py-5 sm:p-6">
                        <div class="flex items-center justify-between mb-3">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                Active
                            </span>
                            <div class="text-sm text-gray-500">189 students</div>
                        </div>
                        <h3 class="text-lg font-medium text-gray-900 mb-2">React Mastery: From Basics to Advanced</h3>
                        <p class="text-sm text-gray-500 mb-4">Comprehensive React course covering hooks, context, and performance tuning.</p>
                        <div class="flex justify-between items-center">
                            <div class="flex items-center">
                                <i class="fas fa-star text-yellow-400 mr-1"></i>
                                <span class="text-sm font-medium text-gray-700">4.7</span>
                            </div>
                            <a href="#" class="text-indigo-600 hover:text-indigo-500 text-sm font-medium">Manage Course</a>
                        </div>
                    </div>
                </div>

                <!-- Course Card 3 -->
                <div class="bg-white overflow-hidden shadow rounded-lg">
                    <div class="h-40 bg-teal-600 flex items-center justify-center">
                        <span class="text-white text-xl font-bold">New Course</span>
                    </div>
                    <div class="px-4 py-5 sm:p-6">
                        <div class="flex items-center justify-between mb-3">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                Draft
                            </span>
                            <div class="text-sm text-gray-500">0 students</div>
                        </div>
                        <h3 class="text-lg font-medium text-gray-900 mb-2">Node.js Backend Development</h3>
                        <p class="text-sm text-gray-500 mb-4">Build scalable backend services with Node.js, Express, and MongoDB.</p>
                        <div class="flex justify-between items-center">
                            <div class="flex items-center">
                                <i class="fas fa-star text-gray-300 mr-1"></i>
                                <span class="text-sm font-medium text-gray-700">-</span>
                            </div>
                            <a href="#" class="text-indigo-600 hover:text-indigo-500 text-sm font-medium">Continue Editing</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Activity -->
        <div>
            <h2 class="text-lg leading-6 font-medium text-gray-900 mb-4">Recent Activity</h2>
            <div class="bg-white shadow overflow-hidden sm:rounded-lg">
                <ul class="divide-y divide-gray-200">
                    <li class="px-4 py-4 sm:px-6">
                        <div class="flex items-center justify-between">
                            <p class="text-sm font-medium text-indigo-600 truncate">
                                New student enrolled in "Advanced JavaScript"
                            </p>
                            <div class="ml-2 flex-shrink-0 flex">
                                <p class="text-xs text-gray-500">2 hours ago</p>
                            </div>
                        </div>
                    </li>
                    <li class="px-4 py-4 sm:px-6">
                        <div class="flex items-center justify-between">
                            <p class="text-sm font-medium text-indigo-600 truncate">
                                New review received for "React Mastery"
                            </p>
                            <div class="ml-2 flex-shrink-0 flex">
                                <p class="text-xs text-gray-500">5 hours ago</p>
                            </div>
                        </div>
                    </li>
                    <li class="px-4 py-4 sm:px-6">
                        <div class="flex items-center justify-between">
                            <p class="text-sm font-medium text-indigo-600 truncate">
                                Assignment submitted in "Web Development Basics"
                            </p>
                            <div class="ml-2 flex-shrink-0 flex">
                                <p class="text-xs text-gray-500">1 day ago</p>
                            </div>
                        </div>
                    </li>
                    <li class="px-4 py-4 sm:px-6">
                        <div class="flex items-center justify-between">
                            <p class="text-sm font-medium text-indigo-600 truncate">
                                Course "Node.js Backend Development" saved as draft
                            </p>
                            <div class="ml-2 flex-shrink-0 flex">
                                <p class="text-xs text-gray-500">2 days ago</p>
                            </div>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>