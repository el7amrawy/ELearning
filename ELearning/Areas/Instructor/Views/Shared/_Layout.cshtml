<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Instructor Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" href="/assets/favicon-instructor.svg">
    <link href="/assets/css/output.css" rel="stylesheet" />
    <link href="/assets/toastify/toastify.min.css" rel="stylesheet" />
    @await RenderSectionAsync("Styles",false)
</head>
<body class="bg-gray-50">
    <partial name="_NavBarPartial" />
    <div class="pt-16">
        @RenderBody()
    </div>
    <partial name="_FooterPartial" />
  
    <script src="/assets/Instructor/js/navbar.js"></script>
    <script src="~/assets/toastify/toastify-js.js"></script>
    <partial name="_NotificationPartial" />
    @await RenderSectionAsync("Scripts",false)
</body>
</html>