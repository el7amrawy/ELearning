<!-- Navbar -->
<nav class="bg-white shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
            <!-- Logo -->
            <div class="flex-shrink-0 flex items-center">
                <h1 class="text-xl font-bold text-indigo-600">
                    <i class="fas fa-graduation-cap mr-2"></i>LearnHub
                </h1>
            </div>

            <!-- Desktop Navigation -->
            <div class="hidden sm:ml-6 sm:flex sm:space-x-8">
                <a asp-action="Index" asp-controller="Home" class="border-indigo-500 text-gray-900 inline-flex items-center px-1 pt-1 text-sm font-medium @(ViewBag.ActiveTab==NavTabsEnum.Dashboard?"border-b-2":string.Empty)">
                    <i class="fas fa-tachometer-alt mr-1"></i> Dashboard
                </a>
                <a asp-action="Index" asp-controller="Courses" class="border-indigo-500 text-gray-900 inline-flex items-center px-1 pt-1 text-sm font-medium @(ViewBag.ActiveTab==NavTabsEnum.Courses?"border-b-2":string.Empty)">
                    <i class="fas fa-book mr-1"></i> Courses
                </a>
                <a asp-action="Index" asp-controller="Students" class="border-indigo-500 text-gray-900 inline-flex items-center px-1 pt-1 text-sm font-medium @(ViewBag.ActiveTab==NavTabsEnum.Students?"border-b-2":string.Empty)">
                    <i class="fas fa-users mr-1"></i> Students
                </a>
                <a href="#" class="border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium">
                    <i class="fas fa-envelope mr-1"></i> Messages
                </a>
            </div>

            <!-- User Profile (Desktop) -->
            <div class="hidden sm:ml-6 sm:flex sm:items-center">
                <div class="ml-3 relative">
                    <button id="user-menu-button" type="button" class="bg-white rounded-full flex text-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                        <span class="sr-only">Open user menu</span>
                        <img class="h-8 w-8 rounded-full" src=@(Context.Request.Cookies["ProfileImage"]??"/assets/dashboard/imgs/user_Placeholder.png") alt="User photo">
                    </button>

                    <!-- Dropdown Menu -->
                    <div id="user-dropdown" class="hidden origin-top-right absolute right-0 mt-2 w-48 rounded-md shadow-lg py-1 bg-white ring-1 ring-black ring-opacity-5 focus:outline-none z-50">
                        <a asp-area="" asp-action="index" asp-controller="user" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                            <i class="fas fa-user mr-2"></i> Your Profile
                        </a>
                        <a href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                            <i class="fas fa-cog mr-2"></i> Settings
                        </a>
                        <a asp-action="logout" asp-controller="account" asp-area="" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                            <i class="fas fa-sign-out-alt mr-2"></i> Log out
                        </a>
                    </div>
                </div>
            </div>

            <!-- Mobile menu button -->
            <div class="-mr-2 flex items-center sm:hidden">
                <button id="mobile-menu-button" type="button" class="inline-flex items-center justify-center p-2 rounded-md text-gray-400 hover:text-gray-500 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-indigo-500">
                    <span class="sr-only">Open main menu</span>
                    <i class="fas fa-bars h-6 w-6"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden sm:hidden">
        <div class="pt-2 pb-3 space-y-1">
            <a asp-action="Index" asp-controller="Home" class="border-indigo-500 text-gray-600 block pl-3 pr-4 py-2 text-base font-medium @(ViewBag.ActiveTab==NavTabsEnum.Dashboard?"border-l-4 bg-indigo-50 text-indigo-700":string.Empty)">
                <i class="fas fa-tachometer-alt mr-2"></i> Dashboard
            </a>
            <a asp-action="Index" asp-controller="Courses" class="border-indigo-500 text-gray-600 block pl-3 pr-4 py-2 text-base font-medium @(ViewBag.ActiveTab==NavTabsEnum.Courses?"border-l-4 bg-indigo-50 text-indigo-700":string.Empty)">
                <i class="fas fa-book mr-2"></i> Courses
            </a>
            <a asp-action="Index" asp-controller="Students" class="border-indigo-500 text-gray-600 block pl-3 pr-4 py-2 text-base font-medium @(ViewBag.ActiveTab==NavTabsEnum.Students?"border-l-4 bg-indigo-50 text-indigo-700":string.Empty)">
                <i class="fas fa-users mr-2"></i> Students
            </a>
            <a href="#" class="border-transparent text-gray-600 hover:bg-gray-50 hover:border-gray-300 hover:text-gray-800 block pl-3 pr-4 py-2 border-l-4 text-base font-medium">
                <i class="fas fa-envelope mr-2"></i> Messages
            </a>
        </div>
        <div class="pt-4 pb-3 border-t border-gray-200">
            <div class="mt-3 space-y-1">
                <a asp-area="" asp-action="index" asp-controller="user" class="block px-4 py-2 text-base font-medium text-gray-500 hover:text-gray-800 hover:bg-gray-100">
                    <i class="fas fa-user mr-2"></i> Your Profile
                </a>
                <a href="#" class="block px-4 py-2 text-base font-medium text-gray-500 hover:text-gray-800 hover:bg-gray-100">
                    <i class="fas fa-cog mr-2"></i> Settings
                </a>
                <a asp-action="logout" asp-controller="account" asp-area="" class="block px-4 py-2 text-base font-medium text-gray-500 hover:text-gray-800 hover:bg-gray-100">
                    <i class="fas fa-sign-out-alt mr-2"></i> Log out
                </a>
            </div>
        </div>
    </div>
</nav>