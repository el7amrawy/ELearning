@{
    var tab = (NavTabsEnum)ViewData["ActiveTab"];
}

<nav class="shadow-md bg-white fixed w-full z-30" style="--link-hover: #4f46e5">
    <div class="mx-auto  max-w-7xl px-2 sm:px-6">
        <div class="relative flex spa  h-16 items-center justify-between">
            <div class="absolute inset-y-0 left-0 flex items-center md:hidden">
                <button type="button" class="relative menu-icon inline-flex items-center justify-center rounded-md p-2 text-gray-950 hover:text-black" aria-controls="mobile-menu" id="mobile-menu-button" aria-expanded="false">
                    <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                    </svg>
                    <svg class="hidden size-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <div class="flex flex-1 items-center justify-center sm:items-stretch md:justify-start">
                <div class="flex-shrink-0 flex items-center cursor-pointer">
                    <h1 class="text-xl font-bold text-indigo-600">
                        <a asp-action="Index" asp-controller="Home">
                            <i class="fas fa-graduation-cap mr-2"></i>EmbedSkill
                        </a>
                    </h1>
                </div>
                <!--  Desktop Navigation -->
                <div class="hidden md:ml-6 md:block w-full">
                    <div class="flex items-center w-full space-x-4" >
                        <a asp-action="Index" asp-controller="Home"
                           class="rounded-md px-3 py-2 text-sm font-medium text-gray-800 transition-all duration-500 shrink-0 nav-link @(tab==NavTabsEnum.Dashboard?"active-nav-link":string.Empty)">
                            <i class="fas fa-tachometer-alt mr-2"></i> Dashboard
                        </a>
                        <a asp-action="Index" asp-controller="Courses" 
                        class="rounded-md px-3 py-2 text-sm font-medium text-gray-800 transition-all duration-500 shrink-0 nav-link @(tab==NavTabsEnum.Courses?"active-nav-link":string.Empty)">
                            <i class="fas fa-book mr-2"></i> Courses
                        </a>
                        <a asp-action="Index" asp-controller="Students" 
                        class="rounded-md px-3 py-2 text-sm font-medium text-gray-800 transition-all duration-500 shrink-0 nav-link @(tab==NavTabsEnum.Students?"active-nav-link":string.Empty)">
                            <i class="fas fa-users mr-2"></i> Students
                        </a>
                    </div>
                </div>
            </div>
            <div class="absolute inset-y-0 right-0 flex items-center pr-2 md:static md:inset-auto md:ml-6 md:pr-0">
                <div class="relative ml-3">
                    <div>
                        <button type="button" class="relative flex rounded-full bg-gray-800 text-sm " id="user-menu-button" aria-expanded="false" aria-haspopup="true">
                            <img class="size-8 rounded-full" src=@(Context.Request.Cookies["ProfileImage"]??"/assets/dashboard/imgs/user_Placeholder.png") alt="User photo">
                        </button>
                    </div>
                    <!-- User Profile -->
                    <div id="user-dropdown" class="hidden absolute right-0 z-10 mt-2 w-48 origin-top-right rounded-md bg-white shadow-lg ring-1 ring-black/5 focus:outline-none p-2" role="menu" aria-orientation="vertical" aria-labelledby="user-menu-button" tabindex="-1">
                        <a asp-area="" asp-action="index" asp-controller="user"
                           class="block font-medium px-4 py-2 text-sm text-gray-700 hover:text-indigo-600 links hover:text-indigo-600">
                            <i class="fas fa-user mr-2"></i> Your Profile
                        </a>
                        <a asp-area="" asp-controller="user" asp-action="index" class="block font-medium px-4 py-2 text-sm text-gray-700 hover:text-indigo-600 links hover:text-indigo-600">
                            <i class="fas fa-cog mr-2"></i> Settings
                        </a>
                        <a asp-action="logout" asp-controller="account" asp-area=""
                           class="block font-medium px-4 py-2 text-sm text-gray-700 hover:text-indigo-600 links hover:text-indigo-600">
                            <i class="fas fa-sign-out-alt mr-2"></i> Log out
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Mobile menu -->
    <div class="md:hidden hidden shadow-md bg-white" style="position: absolute;left: 50%;transform: translateX(-50%);width: 95%;" id="mobile-menu">
        @* <span></span> *@
        <div class="space-y-1 px-2 pb-3 pt-2 ">
            <a asp-action="Index" asp-controller="Home" class="block rounded-md px-3 py-2 text-base font-medium text-gray-800 hover:text-indigo-600 links @(tab==NavTabsEnum.Dashboard?"text-indigo-600 bg-[#eee]":string.Empty)" aria-current="page">
                <i class="fas fa-tachometer-alt mr-1"></i> Dashboard
            </a>
            <a asp-action="Index" asp-controller="Courses" class="block rounded-md px-3 py-2 text-base font-medium text-gray-800 hover:text-indigo-600 links @(tab==NavTabsEnum.Courses?"text-indigo-600 bg-[#eee]":string.Empty)">
                <i class="fas fa-book mr-1"></i> Courses
            </a>
            <a asp-action="Index" asp-controller="Students" class="block rounded-md px-3 py-2 text-base font-medium text-gray-800 hover:text-indigo-600 links @(tab==NavTabsEnum.Students?"text-indigo-600 bg-[#eee]":string.Empty)">
                <i class="fas fa-users mr-1"></i> Students
            </a>
            <a href="#"
               class="block rounded-md px-3 py-2 text-base font-medium text-gray-800 hover:text-indigo-600 links">
                <i class="fas fa-envelope mr-1"></i> Messages
            </a>
        </div>
    </div>
</nav>