@model Course_ViewModel

<div class="bg-white overflow-hidden shadow rounded-lg hover:shadow-md transition-shadow duration-300 h-full flex flex-col">
    <div class="relative w-full aspect-[16/9] flex-shrink-0">
        <img src="@Model.Image?.URL" alt="Course Image" class="w-full h-full object-cover">
    </div>
    <div class="px-4 py-5 sm:p-6 flex-1 flex flex-col">
        <div class="flex items-center flex-wrap gap-2 mb-3">
            <div class="flex items-center text-sm text-gray-500 whitespace-nowrap">
                <i class="fas fa-users mr-1"></i>
                @Model.StudentsNumber students
            </div>
            <div class="flex items-center text-sm text-gray-500 whitespace-nowrap">
                <i class="fas fa-dollar-sign mr-1"></i>
                @(Model.Price == 0 ? "Free" : Model.Price)
            </div>
            <span class="inline-flex text-sm items-center px-2.5 py-0.5 rounded-full font-medium ml-auto @(Model.StatusId==CourseStatusEnum.Published?"bg-green-100 text-green-800":Model.StatusId==CourseStatusEnum.Draft?"bg-yellow-100 text-yellow-800":"bg-red-100 text-red-800")">
                @Model.StatusName
            </span>
        </div>
        <h3 class="text-lg font-bold text-gray-900 line-clamp-2 mb-2 min-h-[56px]">
            @Model.Title    
        </h3>
        <p class="text-sm">
            @Model.SubTitle    
        </p>
        <div class="flex justify-between items-center mt-auto">
            <div class="flex items-center whitespace-nowrap">
                <i class="fas fa-star text-yellow-400 mr-1"></i>
                <span class="text-sm font-medium text-gray-700">4.9</span>
                <span class="mx-1 text-gray-300">•</span>
                <span class="text-sm text-gray-500">156 reviews</span>
            </div>
            <div class="flex space-x-2 relative">
                <a asp-action="Manage" asp-controller="Courses" asp-route-id="@Model.Id" class="inline-flex items-center px-3 py-2 border border-transparent text-sm font-medium rounded-md text-indigo-700 bg-indigo-100 hover:bg-indigo-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors duration-200 whitespace-nowrap">
                    <i class="fas fa-cog mr-2"></i> Manage
                </a>
            </div>
        </div>
    </div>
</div>
