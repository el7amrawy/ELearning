@model ManageCourse_ViewModel;
@using ELearning.Extensions
@{
    ViewBag.Title = "Mangae Course";
    ViewBag.ActiveTab = NavTabsEnum.Courses;
}

<div class="max-w-4xl mx-auto px-4 py-6 space-y-7">
    <!-- Back Button -->
    <div>
        <a asp-action="Index" asp-controller="Courses"
           class="bg-gray-200 inline-block hover:bg-gray-300 text-gray-800 px-4 py-2 rounded-lg transition">
            <i class="fas fa-arrow-left mr-2"></i> Back to Courses
        </a>
    </div>
    <!-- Course Header -->
    <div class="bg-white rounded-lg shadow-md overflow-hidden">
        <!-- 16:9 Thumbnail -->
        <div class="relative pb-[56.25%] bg-gray-200">
            <img src="@Model.Course.Image.URL"
                 alt="Course thumbnail" class="absolute inset-0 w-full h-full object-cover">
            <div class="absolute top-3 right-3 flex gap-2" bis_skin_checked="1">
                <a asp-action="edit" asp-route-id="@Model.Course.Id"
                   class="inline-flex items-center px-3 py-1.5 bg-white text-blue-600 rounded-md shadow-xs text-sm hover:bg-blue-50">
                    <i class="fas fa-edit mr-1.5 text-sm"></i> Edit
                </a>
                @if(Model.Course.StatusId==CourseStatusEnum.Draft){
                    <a asp-action="Publish" asp-route-id="@Model.Course.Id" class="inline-flex items-center px-3 py-1.5 bg-green-600 text-white rounded-md shadow-sm text-sm hover:bg-green-700">
                    <i class="fas fa-cloud-upload-alt mr-1.5 text-sm"></i> Publish
                </a>
                }else{
                    <a asp-action="Unpublish" asp-route-id="@Model.Course.Id" class="inline-flex items-center px-3 py-1.5 bg-yellow-500 text-white rounded-md shadow-sm text-sm hover:bg-yellow-600">
                        <i class="fas fa-ban mr-1.5 text-sm"></i> Unpublish
                    </a>
                }
            </div>
        </div>

        <div class="p-5">
            <div class="flex flex-col">
                <div class="mb-3">
                    <h1 class="text-2xl font-bold text-gray-800">@Model.Course.Title</h1>
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-1 text-sm text-gray-600">
                        <span><i class="fas fa-user-tie mr-1"></i>@Model.Instructor.FirstName @Model.Instructor.LastName</span>
                        <span><i class="fas fa-clock mr-1"></i>@Model.Course.Duration.FormatDuration()</span>
                    </div>
                </div>
                <p class="text-gray-700 mb-3 text-sm">
                    @Model.Course.SubTitle
                </p>
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="inline-flex text-sm items-center px-2.5 py-0.5 rounded-full font-medium @(Model.Course.StatusId==CourseStatusEnum.Published?"bg-green-100 text-green-800":Model.Course.StatusId==CourseStatusEnum.Draft?"bg-yellow-100 text-yellow-800":"bg-red-100 text-red-800")">
                            <i class="fas fa-check-circle mr-1"></i> @Model.Course.StatusName
                        </span>
                        <span class="text-xs text-gray-500">
                            <i class="fas fa-calendar-plus mr-1"></i>Created:  @Html.DisplayFor(m => m.Course.CreatedAt)
                        </span>
                        <span class="text-xs text-gray-500">
                            <i class="fas fa-calendar-check mr-1"></i>Updated: @Model.Course.UpdatedAt
                        </span>
                    </div>
                </div>
            </div>
        </div>
    
    </div>

    <!-- Course Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div class="bg-white rounded-lg shadow-md p-4">
            <div class="flex items-center">
                <div class="p-2 rounded-full bg-blue-100 text-blue-600 mr-3">
                    <i class="fas fa-users text-sm"></i>
                </div>
                <div>
                    <p class="text-gray-500 text-xs">Students</p>
                    <p class="font-bold">142</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow-md p-4">
            <div class="flex items-center">
                <div class="p-2 rounded-full bg-green-100 text-green-600 mr-3">
                    <i class="fas fa-star text-sm"></i>
                </div>
                <div>
                    <p class="text-gray-500 text-xs">Rating</p>
                    <p class="font-bold">4.8/5</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow-md p-4">
            <div class="flex items-center">
                <div class="p-2 rounded-full bg-purple-100 text-purple-600 mr-3">
                    <i class="fas fa-certificate text-sm"></i>
                </div>
                <div>
                    <p class="text-gray-500 text-xs">Completion</p>
                    <p class="font-bold">78%</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Course Description -->
    <div class="bg-white rounded-lg shadow-md overflow-hidden">
        <div class="p-5 border-b border-gray-100">
            <h2 class="text-lg font-semibold text-gray-800 mb-3">
                <i class="fas fa-align-left mr-2 text-blue-500"></i>
                @Html.DisplayNameFor(m=>m.Course.Description)
            </h2>
            <div class="prose prose-sm max-w-none">
                @Html.Raw(Model.Course.Description)
            </div>
        </div>
    </div>
    
    <!-- Course Sections -->
    <div class="bg-white rounded-lg shadow-md overflow-hidden">
        <div class="p-4 border-b border-gray-100 flex justify-between items-center">
            <h2 class="text-lg font-semibold text-gray-800">
                <i class="fas fa-list-ul mr-2 text-blue-500"></i>
                Sections
            </h2>
            <a asp-action="Index" asp-controller="Sections" asp-route-courseid="@Model.Course.Id"
               class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg text-sm hover:bg-blue-700 transition-colors">
                <i class="fas fa-cogs mr-2"></i> Manage Sections
            </a>
        </div>

        <!-- Section List -->
        <div>
            @for (int i = 0; i < Model.Sections.Count; i++)
            {
                <div class="p-4 odd:bg-gray-50 border-b hover:bg-indigo-50">
                    <div class="flex justify-between items-start">
                        <div>
                            <h3 class="font-medium text-gray-800 mb-1">@(i + 1). @Model.Sections[i].Name</h3>
                            <div class="flex items-center text-xs text-gray-500 space-x-3">
                                <span><i class="fas fa-play-circle mr-0.5"></i> @Model.Sections[i].LectureCount lessons</span>
                                <span><i class="fas fa-clock mr-0.5"></i>@Model.Sections[i].Duration.FormatDuration()</span>
                            </div>
                        </div>
                        <div class="flex space-x-1 items-center">
                            <a asp-action="Index"
                               asp-controller="Lectures"
                               asp-route-courseId="@Model.Course.Id"
                               asp-route-sectionId="@Model.Sections[i].Id"
                                class="p-1.5 text-blue-600 hover:text-blue-800 text-sm" title="Edit">
                                <i class="fas fa-cog mr-2"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Danger Zone / Delete Course -->
    <div class="bg-white rounded-lg shadow-md overflow-hidden border border-red-200">
        <div class="p-4 border-b border-red-200 bg-red-50">
            <h2 class="text-lg font-semibold text-red-800">
                <i class="fas fa-exclamation-triangle mr-2"></i>
                Danger Zone
            </h2>
        </div>
        <div class="p-4">
            <div class="text-center mb-4">
                <p class="text-sm text-gray-600 mb-3">
                    Once you delete a course, there is no going back. All content and student data will be permanently removed.
                </p>
            </div>
            <div class="flex justify-center">
                <button onclick="confirmDelete('/instructor/courses/delete/@Model.Course.Id')" asp-action="delete" asp-route-id="@Model.Course.Id" class="px-6 py-2 bg-red-600 text-white rounded-md hover:bg-red-700 flex items-center">
                    <i class="fas fa-trash-alt mr-2"></i> Delete Course
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_DeleteItemAlertPartial");}
}