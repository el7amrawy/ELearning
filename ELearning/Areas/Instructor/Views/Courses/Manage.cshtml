@model ManageCourse_ViewModel;
@{
	ViewBag.Title = "Mangae Course";
	ViewBag.ActiveTab = NavTabsEnum.Courses;
}

<div class="max-w-4xl mx-auto px-4 py-6 space-y-7">
    <!-- Course Header -->
    <div class="bg-white rounded-lg shadow-md overflow-hidden">
        <!-- 16:9 Thumbnail -->
        <div class="relative pb-[56.25%] bg-gray-200">
            <img src="@Model.Course.Image.URL"
                 alt="Course thumbnail" class="absolute inset-0 w-full h-full object-cover">
            <div class="absolute top-3 right-3 flex space-x-2">
                <a asp-action="edit" asp-route-id="@Model.Course.Id"
                   class="inline-flex items-center px-3 py-1.5 bg-white text-blue-600 rounded-md shadow-xs text-sm hover:bg-blue-50">
                    <i class="fas fa-edit mr-1.5 text-sm"></i> Edit
                </a>
            </div>
        </div>

        <div class="p-5">
            <div class="flex flex-col">
                <div class="mb-3">
                    <h1 class="text-2xl font-bold text-gray-800">@Model.Course.Title</h1>
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-1 text-sm text-gray-600">
                        <span><i class="fas fa-user-tie mr-1"></i>@Model.Instructor.FirstName @Model.Instructor.LastName</span>
                        <span><i class="fas fa-clock mr-1"></i>8 hours</span>
                    </div>
                </div>
                <p class="text-gray-700 mb-3 text-sm">
                    @Model.Course.SubTitle
                </p>
                <div>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @(Model.Course.StatusId==CourseStatusEnum.Published?"bg-green-100 text-green-800":Model.Course.StatusId==CourseStatusEnum.Draft?"bg-yellow-100 text-yellow-800":"bg-red-100 text-red-800")">
                        <i class="fas fa-check-circle mr-1"></i> @Model.Course.StatusName
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Course Sections -->
    <div class="bg-white rounded-lg shadow-md overflow-hidden">
        <div class="p-4 border-b border-gray-100 flex justify-between items-center">
            <h2 class="text-lg font-semibold text-gray-800">
                <i class="fas fa-list-ul mr-2 text-blue-500"></i>
                Sections
            </h2>
            <a asp-action="create" asp-controller="sections"
               class="inline-flex items-center px-2.5 py-1.5 bg-blue-600 text-white rounded-md text-sm hover:bg-blue-700">
                <i class="fas fa-plus mr-1.5"></i> Add Section
            </a>
        </div>

        <!-- Section List -->
        <div class="divide-y divide-gray-100">
            <!-- Section 1 -->
            <div class="p-4 hover:bg-gray-50 group">
                <div class="flex justify-between items-start">
                    <div>
                        <h3 class="font-medium text-gray-800 mb-1">JavaScript Fundamentals</h3>
                        <div class="flex items-center text-xs text-gray-500 space-x-3">
                            <span><i class="fas fa-clock mr-0.5"></i> 45 min</span>
                            <span><i class="fas fa-play-circle mr-0.5"></i> 3 lessons</span>
                        </div>
                    </div>
                    <div class="flex space-x-1 items-center">
                        <a href="edit-section.html" class="p-1.5 text-blue-600 hover:text-blue-800 text-sm" title="Edit">
                            <i class="fas fa-edit"></i>
                        </a>
                        <div class="flex flex-col space-y-1">
                            <button class="p-1 text-gray-500 hover:text-gray-700 text-xs" title="Move up">
                                <i class="fas fa-arrow-up"></i>
                            </button>
                            <button class="p-1 text-gray-500 hover:text-gray-700 text-xs" title="Move down">
                                <i class="fas fa-arrow-down"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 2 -->
            <div class="p-4 hover:bg-gray-50 border-black border-2 group">
                <div class="flex justify-between items-start">
                    <div>
                        <h3 class="font-medium text-gray-800 mb-1">Advanced Concepts</h3>
                        <div class="flex items-center text-xs text-gray-500 space-x-3">
                            <span><i class="fas fa-clock mr-0.5"></i> 1.5 hours</span>
                            <span><i class="fas fa-play-circle mr-0.5"></i> 5 lessons</span>
                        </div>
                    </div>
                    <div class="flex space-x-1 items-center">
                        <a href="edit-section.html" class="p-1.5 text-blue-600 hover:text-blue-800 text-sm" title="Edit">
                            <i class="fas fa-edit"></i>
                        </a>
                        <div class="flex flex-col space-y-1">
                            <button class="p-1 text-gray-500 hover:text-gray-700 text-xs" title="Move up">
                                <i class="fas fa-arrow-up"></i>
                            </button>
                            <button class="p-1 text-gray-500 hover:text-gray-700 text-xs" title="Move down">
                                <i class="fas fa-arrow-down"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 3 -->
            <div class="p-4 hover:bg-gray-50 group">
                <div class="flex justify-between items-start">
                    <div>
                        <h3 class="font-medium text-gray-800 mb-1">Modern Frameworks</h3>
                        <div class="flex items-center text-xs text-gray-500 space-x-3">
                            <span><i class="fas fa-clock mr-0.5"></i> 2 hours</span>
                            <span><i class="fas fa-play-circle mr-0.5"></i> 4 lessons</span>
                        </div>
                    </div>
                    <div class="flex space-x-1 items-center">
                        <a href="edit-section.html" class="p-1.5 text-blue-600 hover:text-blue-800 text-sm" title="Edit">
                            <i class="fas fa-edit"></i>
                        </a>
                        <div class="flex flex-col space-y-1">
                            <button class="p-1 text-gray-500 hover:text-gray-700 text-xs" title="Move up">
                                <i class="fas fa-arrow-up"></i>
                            </button>
                            <button class="p-1 text-gray-500 hover:text-gray-700 text-xs" title="Move down">
                                <i class="fas fa-arrow-down"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Course Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div class="bg-white rounded-lg shadow-md p-4">
            <div class="flex items-center">
                <div class="p-2 rounded-full bg-blue-100 text-blue-600 mr-3">
                    <i class="fas fa-users text-sm"></i>
                </div>
                <div>
                    <p class="text-gray-500 text-xs">Students</p>
                    <p class="font-bold">142</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow-md p-4">
            <div class="flex items-center">
                <div class="p-2 rounded-full bg-green-100 text-green-600 mr-3">
                    <i class="fas fa-star text-sm"></i>
                </div>
                <div>
                    <p class="text-gray-500 text-xs">Rating</p>
                    <p class="font-bold">4.8/5</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow-md p-4">
            <div class="flex items-center">
                <div class="p-2 rounded-full bg-purple-100 text-purple-600 mr-3">
                    <i class="fas fa-certificate text-sm"></i>
                </div>
                <div>
                    <p class="text-gray-500 text-xs">Completion</p>
                    <p class="font-bold">78%</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Danger Zone / Delete Course -->
    <div class="bg-white rounded-lg shadow-md overflow-hidden border border-red-200">
        <div class="p-4 border-b border-red-200 bg-red-50">
            <h2 class="text-lg font-semibold text-red-800">
                <i class="fas fa-exclamation-triangle mr-2"></i>
                Danger Zone
            </h2>
        </div>
        <div class="p-4">
            <div class="text-center mb-4">
                <p class="text-sm text-gray-600 mb-3">
                    Once you delete a course, there is no going back. All content and student data will be permanently removed.
                </p>
            </div>
            <div class="flex justify-center">
                <button onclick="confirmDelete('/instructor/courses/delete/@Model.Course.Id')" asp-action="delete" asp-route-id="@Model.Course.Id" class="px-6 py-2 bg-red-600 text-white rounded-md hover:bg-red-700 flex items-center">
                    <i class="fas fa-trash-alt mr-2"></i> Delete Course
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_DeleteItemAlertPartial");}
}