@{
    ViewBag.Title = "Home";
    ViewBag.Active = AsideTabs.Dashboard;
}

<div class="flex-1 flex flex-col">
    <!-- Content -->
    <main class="p-6 flex-1">
        <div class="mb-6 bg-white p-6 rounded-lg shadow-lg bg-opacity-90">
            <h2 class="text-xl font-semibold text-black mb-2">Overview</h2>
            <p class="text-gray-600">Monitor your activities and manage your settings from here.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <div class="bg-white p-6 rounded-lg shadow-lg hover:shadow-xl transition duration-200 bg-opacity-90">
                <h2 class="text-lg font-semibold text-black mb-2"><i class="mdi mdi-account-multiple mr-2"></i> Users</h2>
                <p class="text-gray-600">View and manage user information.</p>
            </div>
            <div class="bg-white p-6 rounded-lg shadow-lg hover:shadow-xl transition duration-200 bg-opacity-90">
                <h2 class="text-lg font-semibold text-black mb-2"><i class="mdi mdi-bell mr-2"></i> Activity</h2>
                <p class="text-gray-600">Check recent updates and notifications.</p>
            </div>
            <div class="bg-white p-6 rounded-lg shadow-lg hover:shadow-xl transition duration-200 bg-opacity-90">
                <h2 class="text-lg font-semibold text-black mb-2"><i class="mdi mdi-checkbox-multiple-marked mr-2"></i> Tasks</h2>
                <p class="text-gray-600">Track and manage your tasks.</p>
            </div>
        </div>
    </main>
</div>