@model Language
@{
    ViewBag.Title = "Add New Language";
    ViewBag.Active = AsideTabs.Languages;
}


<main class="bg-gray-50 min-h-screen flex items-center justify-center p-4">
    <div class="w-full max-w-md">
        <div class="bg-white rounded-lg shadow-md p-6">
            <!-- Header -->
            <div class="mb-6 flex items-center">
                <span class="mdi mdi-translate text-2xl text-blue-500 mr-2"></span>
                <h2 class="text-xl font-semibold text-gray-800">Add New Language</h2>
            </div>

            <form asp-action="create" class="space-y-4">
                <!-- Name Field -->
                <div>
                    <label asp-for="Name" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <div class="relative">
                        <input asp-for="Name"
                               class="block w-full focus:outline-none px-3 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500"
                               placeholder="Enter name">
                    </div>
                    <span asp-validation-for="Name" class="text-red-500"></span>
                </div>

                <!-- Buttons -->
                <div class="flex justify-between pt-4">
                    <a asp-action="Index" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50">
                        <span class="mdi mdi-arrow-left mr-2"></span> Back
                    </a>
                    <button type="submit" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700">
                        <span class="mdi mdi-content-save-outline mr-2"></span> Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</main>

@section Scripts{
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}