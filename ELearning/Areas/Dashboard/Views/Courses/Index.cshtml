@using ELearning.Core.Enums
@model IEnumerable<Course_ViewModel>
@{
    ViewBag.Title = "Courses";
    ViewBag.Active = AsideTabs.Courses;
    var pagination = (Pagination)ViewBag.Pagination;
}

<main class="bg-gray-50 min-h-screen p-6">
    <div class="max-w-6xl mx-auto">
        <!-- Header -->
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-2xl font-bold text-gray-800">
                <i class="mdi mdi-bookshelf"></i>
                Courses
            </h1>
        </div>

        <!-- Table -->
        <div class="bg-white rounded-lg shadow-md overflow-hidden">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-800">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-white uppercase tracking-wider">
                            @Html.DisplayNameFor(c => c.Image)
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-white uppercase tracking-wider">
                            @Html.DisplayNameFor(c => c.Title)
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-white uppercase tracking-wider">
                            @Html.DisplayNameFor(c => c.Price)
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-white uppercase tracking-wider">
                            @Html.DisplayNameFor(c => c.Level)
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-white uppercase tracking-wider">
                            @Html.DisplayNameFor(c => c.Language)
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-white uppercase tracking-wider">
                            @Html.DisplayNameFor(c => c.StatusId)
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-white uppercase tracking-wider">
                            @Html.DisplayNameFor(c => c.CreatedAt)
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-white uppercase tracking-wider">
                            @Html.DisplayNameFor(c => c.UpdatedAt)
                        </th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                                <img src="@item.Image" alt="Category Image"
                                class="h-10 w-10 object-cover rounded">
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                @item.Title
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-500">
                                @Html.DisplayFor(_ => item.Price)
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                @Html.DisplayFor(_ => item.Level.Name)
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                @Html.DisplayFor(_ => item.Language.Name)
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                @switch (item.StatusId)
                                {
                                    case CourseStatusEnum.Canceled:
                                        <span class="inline-block px-3 py-1 text-sm font-semibold text-white bg-red-500 rounded-full">
                                            Canceled
                                        </span>
                                        break;
                                    case CourseStatusEnum.Published:
                                        <span class="inline-block px-3 py-1 text-sm font-semibold text-white bg-green-500 rounded-full">
                                            Published
                                        </span>
                                        break;
                                    default:
                                        <span class="inline-block px-3 py-1 text-sm font-semibold text-white bg-yellow-500 rounded-full">
                                            Draft
                                        </span>
                                        break;
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                @Html.DisplayFor(_ => item.CreatedAt)
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                @Html.DisplayFor(_ => item.UpdatedAt)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <!-- Pagination -->
        @if (pagination.Count > pagination.PageSize)
        {
            <div class="flex items-center justify-between mt-4 px-4 py-3 bg-white border-t border-gray-200 sm:px-6">
                <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
                    <div>
                        <p class="text-sm text-gray-700">
                            Page <span class="font-medium">@pagination.PageNumber</span> of <span class="font-medium">@pagination.Pages</span>
                        </p>
                    </div>
                    <div>
                        <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                            <a asp-action="Index" asp-route-pagenumber="@(pagination.PageNumber-1)" class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50">
                                <span class="sr-only">Previous</span>
                                <i class="mdi mdi-chevron-left"></i>
                            </a>
                            @for (int i = 1; i <= pagination.Pages; i++)
                            {
                                <a asp-action="Index" asp-route-pagenumber="@i" aria-current="page" class="hover:bg-gray-100 relative inline-flex items-center px-4 py-2 border text-sm font-medium @(i==pagination.PageNumber?"z-10 bg-blue-50 border-blue-500 text-blue-600":"border-gray-300 text-gray-500")">
                                    @i
                                </a>
                            }
                            <a asp-action="Index" asp-route-pagenumber="@(pagination.PageNumber+1)" class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50">
                                <span class="sr-only">Next</span>
                                <i class="mdi mdi-chevron-right"></i>
                            </a>
                        </nav>
                    </div>
                </div>
            </div>
        }
    </div>
</main>
