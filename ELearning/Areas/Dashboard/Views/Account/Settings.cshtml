@model ResetPassword_ViewModel
@{
	ViewBag.Title = "Settings";
}

<section class="section main-section">
    <form asp-action="Settings" class="border-2 mt-6 rounded-lg">
        <div class="card">
            <header class="card-header">
                <p class="card-header-title">
                    <span class="icon"><i class="mdi mdi-lock"></i></span>
                    Change Password
                </p>
            </header>
            <div class="card-content">
                <div class="field">
                    <label class="label" asp-for="OldPassword"></label>
                    <div class="control">
                        <input asp-for="OldPassword" class="input">
                    </div>
                    <span asp-validation-for="OldPassword" class="text-red-500"></span>
                </div>
                <hr>
                <div class="field">
                    <label class="label" asp-for="NewPassword"></label>
                    <div class="control">
                        <input asp-for="NewPassword" class="input" >
                    </div>
                    <span asp-validation-for="NewPassword" class="text-red-500"></span>
                </div>
                <div class="field">
                    <label class="label" asp-for="ConfirmPassword"></label>
                    <div class="control">
                        <input asp-for="ConfirmPassword" class="input">
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-red-500"></span>
                </div>
                <hr>
                <div class="field">
                    <div class="control">
                        <button type="submit" class="button green">
                            Change
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script type="text/javascript" src="/assets/dashboard/js/profile.js"></script>
}