@{
    var tab = (AsideTabs)ViewData["Active"];
}
<aside class="aside is-placed-left is-expanded">
    <div class="aside-tools">
        <div>ELearning <b class="font-black">Admin</b></div>
    </div>
    <div class="menu is-menu-main">
        <p class="menu-label">General</p>
        <ul class="menu-list">
            <li class="@(tab==AsideTabs.Dashboard?"active":string.Empty)">
                <a asp-controller="Home" asp-action="Index">
                    <span class="icon"><i class="mdi mdi-desktop-mac"></i></span>
                    <span class="menu-item-label">Dashboard</span>
                </a>
            </li>
            <li class="@(tab==AsideTabs.Courses?"active":string.Empty)">
                <a asp-controller="Courses" asp-action="Index">
                    <span class="icon"><i class="mdi mdi-bookshelf"></i></span>
                    <span class="menu-item-label">Courses</span>
                </a>
            </li>
        </ul>
        <p class="menu-label">Course</p>
        <ul class="menu-list">
            <li class="@(tab==AsideTabs.Categories?"active":string.Empty)">
                <a asp-controller="Categories" asp-action="Index">
                    <span class="icon"><i class="mdi mdi-tag"></i></span>
                    <span class="menu-item-label">Categories</span>
                </a>
            </li>
            <li class="@(tab==AsideTabs.Languages?"active":string.Empty)">
                <a asp-controller="Languages" asp-action="Index">
                    <span class="icon"><i class="mdi mdi-translate"></i></span>
                    <span class="menu-item-label">Languages</span>
                </a>
            </li>
        </ul>
    </div>
</aside>